{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP Agent Status Component",
  "type": "object",
  "required": ["agent", "state"],
  "properties": {
    "agent": { "type": "string" },
    "state": { "type": "string", "enum": ["idle", "running", "failed", "completed"] },
    "lastTask": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
