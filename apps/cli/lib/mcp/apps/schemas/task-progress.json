{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MCP Task Progress Component",
  "type": "object",
  "required": ["task", "progress"],
  "properties": {
    "task": { "type": "string" },
    "progress": { "type": "number", "minimum": 0, "maximum": 100 },
    "steps": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string" }
  }
}
