#compdef ultra-dex
# Ultra-Dex CLI Zsh Completion

_ultra_dex() {
    local curcontext="$curcontext" state line
    typeset -A opt_args
    
    _arguments -C \
        '(-h --help)'{-h,--help}'[Show help]' \
        '(-v --version)'{-v,--version}'[Show version]' \
        '(--verbose)'--verbose'[Verbose output]' \
        '(--debug)'--debug'[Debug mode]' \
        '(--json)'--json'[JSON output]' \
        '1: :_ultra_dex_commands' \
        '*:: :->args'
    
    case "$state" in
        args)
            case "$line[1]" in
                init)
                    _arguments \
                        '(--template)'--template'[Template type]:template:(lite full enterprise)' \
                        '(--force)'--force'[Force overwrite]' \
                        '(--skip-git)'--skip-git'[Skip git init]'
                    ;;
                run)
                    _arguments \
                        '1:agent:_ultra_dex_agents'
                    ;;
                swarm)
                    _arguments \
                        '(--dry-run)'--dry-run'[Dry run only]' \
                        '(--parallel)'--parallel'[Run implementation agents in parallel]' \
                        '(--agents)'--agents'[Specific agents]:agents:' \
                        '(--timeout)'--timeout'[Timeout in ms]:timeout:'
                    ;;
                agents)
                    _arguments \
                        '1:action:(list install create publish)' \
                        '(--marketplace)'--marketplace'[Browse marketplace]'
                    ;;
                plugin)
                    _arguments \
                        '1:action:(list marketplace create install uninstall info update search)'
                    ;;
                browser)
                    _arguments \
                        '1:action:(screenshot scrape test record mockup audit)'
                    ;;
                sync)
                    _arguments \
                        '(--brain)'--brain'[Sync with brain]' \
                        '(--watch)'--watch'[Watch mode]' \
                        '(--force)'--force'[Force sync]'
                    ;;
                memory)
                    _arguments \
                        '1:action:(list add search clear sessions decisions query stats)'
                    ;;
                estimate)
                    _arguments \
                        '1:task type:(simple-task feature-impl plan-generation complex-refactor agent-swarm context-sync)' \
                        '(--tokens)'--tokens'[Token count]:tokens:' \
                        '(--provider)'--provider'[AI provider]:provider:(openai anthropic google gemini ollama local)' \
                        '(--monthly)'--monthly'[Monthly estimate]:count:' \
                        '(--json)'--json'[JSON output]'
                    ;;
                voice)
                    _arguments \
                        '(--provider)'--provider'[STT provider]:provider:(whisper google azure)' \
                        '(--language)'--language'[Language code]:lang:' \
                        '(--output)'--output'[Output file]:file:_files' \
                        '(--template)'--template'[Template]:template:(lite full enterprise)' \
                        '(--save-audio)'--save-audio'[Save audio file]'
                    ;;
                check)
                    _arguments \
                        '(--p0-only)'--p0-only'[Check only P0 sections]' \
                        '(--json)'--json'[JSON output]' \
                        '(--sections)'--sections'[Specific sections]:numbers:'
                    ;;
                export)
                    _arguments \
                        '(--format)'--format'[Export format]:format:(json html md markdown pdf yaml)' \
                        '(--pdf)'--pdf'[Shortcut for PDF export]' \
                        '(--output)'--output'[Output file]:file:_files' \
                        '(--sections)'--sections'[Specific sections]:numbers:' \
                        '(--include-agents)'--include-agents'[Include agent prompts]' \
                        '(--toc)'--toc'[Include table of contents]' \
                        '(--template)'--template'[Custom template file]:file:_files'
                    ;;
                diff)
                    _arguments \
                        '(--json)'--json'[JSON output]' \
                        '(--drift)'--drift'[Drift analysis]' \
                        '(--with-example)'--with-example'[Compare with example]:name:' \
                        '(--report)'--report'[Write report to file]:file:_files' \
                        '(--output)'--output'[Alias for --report]:file:_files'
                    ;;
                repl)
                    _arguments \
                        '(--continue)'--continue'[Resume last session]'
                    ;;
                scaffold)
                    _arguments \
                        '(--output)'--output'[Output directory]:dir:_files' \
                        '(--list)'--list'[List templates]' \
                        '(--from-plan)'--from-plan'[Scaffold from plan]' \
                        '(--dry-run)'--dry-run'[Show plan-based output only]' \
                        '(--force)'--force'[Overwrite existing files]' \
                        '(--page)'--page'[List page]:page:' \
                        '(--limit)'--limit'[Items per page]:count:' \
                        '(--json)'--json'[JSON output]'
                    ;;
                scaffold-plan)
                    _arguments \
                        '(--dry-run)'--dry-run'[Show what would be created]' \
                        '(--force)'--force'[Overwrite existing files]'
                    ;;
                watch)
                    _arguments \
                        '(--debounce)'--debounce'[Debounce interval in ms]' \
                        '(--interval)'--interval'[Debounce interval (deprecated)]' \
                        '(--sync)'--sync'[Auto-sync CONTEXT.md]' \
                        '(--ignore)'--ignore'[Ignore patterns]:patterns:'
                    ;;
                setup)
                    _arguments \
                        '(--quick)'--quick'[Quick setup with defaults]' \
                        '(--reset)'--reset'[Reset configuration to defaults]' \
                        '(--completions)'--completions'[Install shell completions]'
                    ;;
            esac
            ;;
    esac
}

