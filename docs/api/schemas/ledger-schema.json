{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ultra-Dex Ledger Entry",
  "type": "object",
  "required": ["id", "timestamp", "agent", "action", "decision", "rationale"],
  "properties": {
    "id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "agent": { "type": "string" },
    "action": { "type": "string" },
    "decision": { "type": "string" },
    "rationale": { "type": "string" },
    "affected_files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints_checked": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL"] }
        },
        "required": ["rule", "status"]
      }
    },
    "checksum": { "type": "string" }
  }
}
