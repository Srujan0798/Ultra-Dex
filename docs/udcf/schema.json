{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ultra-Dex Context Format (UDCF) v1.0",
  "type": "object",
  "required": ["project", "context", "architecture", "decisions", "tasks", "metadata"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    },
    "context": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "architecture": {
      "type": "object",
      "properties": {
        "stack": { "type": "array", "items": { "type": "string" } },
        "components": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "summary"],
        "properties": {
          "id": { "type": "string" },
          "summary": { "type": "string" },
          "status": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "type": "string" },
          "owner": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "generatedAt": { "type": "string" },
        "source": { "type": "string" },
        "version": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
