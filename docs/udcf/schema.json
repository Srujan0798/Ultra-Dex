{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ultra-Dex Context Format",
  "type": "object",
  "required": ["project", "context", "plan"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "stack": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "priority"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "priority": {"type": "string"}
        }
      }
    }
  }
}
