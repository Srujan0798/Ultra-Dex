{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ultra-Dex Meta-Layer Configuration",
  "description": "Configuration schema for the AI Orchestration Meta-Layer",
  "type": "object",
  "properties": {
    "metaLayer": {
      "type": "object",
      "description": "Meta-layer specific configurations",
      "properties": {
        "version": {
          "type": "string",
          "description": "Meta-layer version",
          "default": "6.0.0"
        },
        "name": {
          "type": "string",
          "description": "Meta-layer name",
          "default": "Ultra-Dex"
        },
        "mode": {
          "type": "string",
          "enum": ["development", "staging", "production", "benchmark"],
          "default": "development"
        }
      },
      "required": ["version", "name"]
    },
    "aiProviders": {
      "type": "object",
      "description": "AI provider configurations",
      "properties": {
        "openai": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "apiKey": { "type": "string" },
            "defaultModel": { "type": "string", "default": "gpt-4o" },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.7 }
          }
        },
        "anthropic": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "apiKey": { "type": "string" },
            "defaultModel": { "type": "string", "default": "claude-3-5-sonnet-latest" },
            "temperature": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 }
          }
        },
        "google": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "apiKey": { "type": "string" },
            "defaultModel": { "type": "string", "default": "gemini-2.0-flash" },
            "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0.7 }
          }
        },
        "ollama": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "baseUrl": { "type": "string", "default": "http://localhost:11434" },
            "defaultModel": { "type": "string", "default": "llama3.2" }
          }
        }
      }
    },
    "orchestration": {
      "type": "object",
      "description": "Orchestration and workflow configurations",
      "properties": {
        "maxConcurrentAgents": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 10
        },
        "timeout": {
          "type": "number",
          "description": "Request timeout in milliseconds",
          "default": 120000
        },
        "retryPolicy": {
          "type": "object",
          "properties": {
            "maxRetries": { "type": "number", "default": 3 },
            "backoffMultiplier": { "type": "number", "default": 2 },
            "initialDelay": { "type": "number", "default": 1000 }
          }
        },
        "circuitBreaker": {
          "type": "object",
          "properties": {
            "threshold": { "type": "number", "default": 5 },
            "timeout": { "type": "number", "default": 60000 }
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "description": "Memory and context management",
      "properties": {
        "storage": {
          "type": "string",
          "enum": ["sqlite", "postgres", "redis", "memory"],
          "default": "sqlite"
        },
        "ttl": {
          "type": "number",
          "description": "Time-to-live for memory entries in seconds",
          "default": 86400
        },
        "maxSize": {
          "type": "number",
          "description": "Maximum memory size in MB",
          "default": 1024
        }
      }
    },
    "security": {
      "type": "object",
      "description": "Security configurations",
      "properties": {
        "enableSandbox": {
          "type": "boolean",
          "description": "Enable code execution sandboxing",
          "default": true
        },
        "allowedDomains": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["localhost", "127.0.0.1"]
        },
        "rateLimiting": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "windowMs": { "type": "number", "default": 900000 },
            "maxRequests": { "type": "number", "default": 100 }
          }
        }
      }
    },
    "monitoring": {
      "type": "object",
      "description": "Performance and monitoring configurations",
      "properties": {
        "enableMetrics": {
          "type": "boolean",
          "default": true
        },
        "enableTracing": {
          "type": "boolean",
          "default": true
        },
        "samplingRate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1.0
        }
      }
    }
  },
  "required": ["metaLayer"]
}