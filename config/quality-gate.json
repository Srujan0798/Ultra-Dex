{
  "version": "6.0.0",
  "meta_layer": "ENABLED",
  "gates": {
    "syntax": {
      "enabled": true,
      "fail_on_error": true
    },
    "linting": {
      "enabled": true,
      "fail_on_error": true,
      "engine": "eslint"
    },
    "testing": {
      "enabled": true,
      "min_coverage": 90,
      "fail_on_error": true
    },
    "security": {
      "enabled": true,
      "scan_secrets": true,
      "fail_on_critical": true,
      "sandbox_execution": "MANDATORY"
    },
    "protocol_21": {
      "enabled": true,
      "automation": "FULL"
    },
    "architectural": {
      "enabled": true,
      "enforce_esm": true,
      "enforce_dry": true,
      "enforce_atomic_tasks": true
    }
  },
  "forbidden_patterns": [
    {
      "pattern": "eval\\(",
      "severity": "CRITICAL",
      "message": "Dynamic code execution is strictly forbidden."
    },
    {
      "pattern": "process\\.env",
      "severity": "WARNING",
      "message": "Avoid direct env access; use ConfigManager."
    }
  ]
}
