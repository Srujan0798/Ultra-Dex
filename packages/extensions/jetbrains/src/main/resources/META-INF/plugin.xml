<!-- Plugin Configuration File -->
<idea-plugin>
  <id>com.ultra-dex.intellij</id>
  <name>Ultra-Dex AI Development</name>
  <version>4.2.0</version>
  <vendor email="contact@ultra-dex.ai" url="https://ultra-dex.ai">Ultra-Dex</vendor>

  <description><![CDATA[
  AI-powered development tools with persistent memory and governance.
  <br/>
  Features:
  <ul>
    <li>AI agent orchestration with 18+ specialized agents</li>
    <li>Persistent context management with hot/warm/cold memory tiers</li>
    <li>Enterprise governance with Protocol 21 verification</li>
    <li>Model Context Protocol (MCP) integration for Claude Desktop</li>
    <li>Voice-to-code functionality with Whisper API</li>
    <li>Computer use agent for desktop automation</li>
    <li>Vision agent for screenshot-to-code conversion</li>
    <li>Self-healing CI/CD with autonomous bug fixes</li>
    <li>Multi-IDE support with real-time synchronization</li>
    <li>Enterprise features: RBAC, SSO, compliance, on-premise</li>
  </ul>
  ]]></description>

  <change-notes><![CDATA[
  <b>v4.2.0 "The Endgame" - Complete AI Development Platform</b><br/>
  - Added voice-to-code with Whisper API integration<br/>
  - Added vision agent for screenshot-to-code conversion<br/>
  - Added computer use agent for desktop automation<br/>
  - Added autonomous daemon mode with 24/7 AI monitoring<br/>
  - Added comprehensive web dashboard with real-time metrics<br/>
  - Added agent marketplace with plugin system<br/>
  - Added LangGraph integration for complex workflows<br/>
  - Added self-healing CI/CD with autonomous bug fixes<br/>
  - Added enterprise features: RBAC, SSO, compliance<br/>
  - Added 6 new SaaS templates<br/>
  - 1,200+ tests with 75%+ coverage<br/>
  ]]></change-notes>

  <!-- Minimum required platform version -->
  <idea-version since-build="221"/>

  <!-- Product descriptors for different IDEs -->
  <depends>com.intellij.modules.platform</depends>
  <depends optional="true" config-file="web-types.xml">com.intellij.modules.web</depends>
  <depends optional="true" config-file="java-types.xml">com.intellij.modules.java</depends>
  <depends optional="true" config-file="python-types.xml">com.intellij.modules.python</depends>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Add your extensions here -->
    <applicationService serviceImplementation="com.ultradex.core.UltimateDexService"/>
    <projectService serviceImplementation="com.ultradex.project.ProjectContextService"/>
    <projectService serviceImplementation="com.ultradex.agents.AgentManager"/>
    <projectService serviceImplementation="com.ultradex.memory.MemoryManager"/>
    <projectService serviceImplementation="com.ultradex.mcp.MCPConnectionService"/>
    
    <!-- UI Components -->
    <toolWindow id="Ultra-Dex Dashboard" 
                factoryClass="com.ultradex.ui.DashboardToolWindowFactory" 
                anchor="right"/>
    <toolWindow id="AI Agents" 
                factoryClass="com.ultradex.ui.AgentsToolWindowFactory" 
                anchor="right"/>
    <toolWindow id="Project Context" 
                factoryClass="com.ultradex.ui.ContextToolWindowFactory" 
                anchor="left"/>
    <toolWindow id="Memory Tiers" 
                factoryClass="com.ultradex.ui.MemoryToolWindowFactory" 
                anchor="bottom"/>
  </extensions>

  <actions>
    <!-- Main Menu Actions -->
    <group id="UltimateDex.MainMenu" text="Ultra-Dex" description="Ultra-Dex AI Development Tools">
      <add-to-group group-id="MainMenu" anchor="last"/>
      
      <action id="UltimateDex.OpenDashboard" 
              class="com.ultradex.actions.OpenDashboardAction" 
              text="Open Dashboard" 
              description="Open Ultra-Dex dashboard">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift D"/>
      </action>
      
      <action id="UltimateDex.RunAgent" 
              class="com.ultradex.actions.RunAgentAction" 
              text="Run AI Agent" 
              description="Run a specialized AI agent">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift A"/>
      </action>
      
      <action id="UltimateDex.VoiceCommand" 
              class="com.ultradex.actions.VoiceCommandAction" 
              text="Voice Command" 
              description="Convert voice to code">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift V"/>
      </action>
      
      <action id="UltimateDex.AnalyzeFile" 
              class="com.ultradex.actions.AnalyzeFileAction" 
              text="Analyze File with AI" 
              description="Analyze current file with AI">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift F"/>
      </action>
      
      <action id="UltimateDex.StartMCP" 
              class="com.ultradex.actions.StartMCPAction" 
              text="Start MCP Server" 
              description="Start Model Context Protocol server">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift M"/>
      </action>
      
      <action id="UltimateDex.SyncContext" 
              class="com.ultradex.actions.SyncContextAction" 
              text="Sync Context" 
              description="Sync project context with Ultra-Dex">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift S"/>
      </action>
      
      <separator/>
      
      <action id="UltimateDex.Settings" 
              class="com.ultradex.actions.SettingsAction" 
              text="Settings" 
              description="Configure Ultra-Dex settings">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift P"/>
      </action>
    </group>
    
    <!-- Editor Popup Menu Actions -->
    <group id="UltimateDex.EditorPopupMenu" text="Ultra-Dex" popup="true">
      <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="EditorToggleUseSoftWraps"/>
      
      <action id="UltimateDex.AnalyzeSelection" 
              class="com.ultradex.actions.AnalyzeSelectionAction" 
              text="Analyze Selection with AI" 
              description="Analyze selected code with AI">
      </action>
      
      <action id="UltimateDex.RefactorSelection" 
              class="com.ultradex.actions.RefactorSelectionAction" 
              text="Refactor with AI" 
              description="Refactor selected code with AI">
      </action>
      
      <action id="UltimateDex.DocumentSelection" 
              class="com.ultradex.actions.DocumentSelectionAction" 
              text="Document with AI" 
              description="Generate documentation for selected code">
      </action>
    </group>
  </actions>

  <applicationListeners>
    <listener class="com.ultradex.listeners.ProjectOpenListener" topic="com.intellij.openapi.project.ProjectManagerListener"/>
    <listener class="com.ultradex.listeners.FileChangeListener" topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
  </applicationListeners>
</idea-plugin>