{
  "name": "@ultra-dex/sdk",
  "version": "2.1.0",
  "description": "Official Ultra-Dex SDK for JavaScript and TypeScript",
  "type": "module",
  "main": "./src/client.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/client.js"
    },
    "./client": {
      "types": "./types/client.d.ts",
      "import": "./src/client.js"
    },
    "./agent": {
      "types": "./types/agent.d.ts",
      "import": "./src/agent.js"
    },
    "./provider": {
      "types": "./types/provider.d.ts",
      "import": "./src/provider.js"
    },
    "./plugin": {
      "types": "./types/plugin.d.ts",
      "import": "./src/plugin.js"
    }
  },
  "files": [
    "src/",
    "types/",
    "README.md"
  ],
  "scripts": {
    "test": "node --test",
    "build": "echo 'No build step required for ESM JavaScript sources'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ultra-dex",
    "ai",
    "sdk",
    "agents",
    "orchestration",
    "plugins"
  ],
  "author": "Srujan Sai Karna",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Srujan0798/Ultra-Dex"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.7.0"
  }
}
