{
  "name": "@ultra-dex/plugin-template",
  "version": "6.0.0",
  "description": "Ultra-Dex Plugin Template - Starter template for creating plugins",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test",
    "lint": "eslint .",
    "validate": "node scripts/validate.js"
  },
  "keywords": [
    "ultra-dex",
    "plugin",
    "template"
  ],
  "author": "Your Name",
  "license": "MIT",
  "peerDependencies": {
    "@ultra-dex/core": "^6.0.0"
  },
  "manifest": {
    "id": "template",
    "name": "Plugin Template",
    "version": "6.0.0",
    "description": "Starter template for Ultra-Dex plugins",
    "author": "Your Name",
    "category": "template",
    "tags": [
      "starter",
      "template",
      "example"
    ],
    "icon": "🧩",
    "entryPoint": "index.js",
    "permissions": [
      "read:config",
      "write:logs"
    ],
    "hooks": [
      "before:task",
      "after:task",
      "on:error"
    ],
    "configSchema": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "option1": {
          "type": "string",
          "description": "Example configuration option"
        }
      }
    },
    "compatibility": {
      "ultra-dex": ">=6.0.0",
      "node": ">=18.0.0"
    }
  }
}
