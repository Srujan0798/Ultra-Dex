<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>dev.ultradex.plugin</id>
    <name>Ultra-Dex</name>
    <vendor email="support@ultra-dex.dev" url="https://ultra-dex.dev">Ultra-Dex Team</vendor>

    <description><![CDATA[
    <h2>Ultra-Dex: AI Orchestration for JetBrains IDEs</h2>
    <p>
        Seamlessly integrate Ultra-Dex CLI into your IntelliJ-based IDEs.
        Orchestrate AI agents, generate code, and manage your project context directly from the sidebar.
    </p>
    <h3>Features:</h3>
    <ul>
        <li>🚀 <strong>Project Dashboard:</strong> View status, phases, and agent activities.</li>
        <li>🤖 <strong>Agent Swarm:</strong> Trigger autonomous development swarms.</li>
        <li>📝 <strong>Context Management:</strong> Sync project context and documentation.</li>
        <li>⚡ <strong>Quick Actions:</strong> One-click access to scaffolding, testing, and fixing.</li>
    </ul>
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <!-- Extension points defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Ultra-Dex" secondary="false" icon="AllIcons.Nodes.Console" anchor="right"
                    factoryClass="dev.ultradex.plugin.ui.UltraDexToolWindowFactory"/>
        
        <notificationGroup id="Ultra-Dex Notifications"
                           displayType="BALLOON"
                           key="Ultra-Dex Notifications"/>
    </extensions>
    
    <actions>
        <group id="UltraDex.TopMenu" text="Ultra-Dex" description="Ultra-Dex Actions">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <action id="UltraDex.Generate" class="dev.ultradex.plugin.actions.GenerateAction" text="Generate Plan" description="Generate implementation plan"/>
            <action id="UltraDex.Sync" class="dev.ultradex.plugin.actions.SyncAction" text="Sync Context" description="Sync project context"/>
        </group>
    </actions>
</idea-plugin>
