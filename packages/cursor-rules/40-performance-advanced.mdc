// 5. Memoized Components with Proper Dependencies
// components/memoized-components.tsx
import { useMemo, useCallback, memo } from 'react';

// Memoized expensive component
export const ExpensiveListComponent = memo(({ items, onItemClick }) => {
  // Memoize expensive computations
  const processedItems = useMemo(() => {
    return items.map(item => ({
      ...item,
      processed: true,
      computedValue: item.value * 2 // Example expensive computation
    }));
  }, [items]);

  // Memoize callback to prevent unnecessary re-renders
  const handleClick = useCallback((item) => {
    onItemClick(item);
  }, [onItemClick]);

  return (
    <div className="space-y-2">
      {processedItems.map(item => (
        <div 
          key={item.id} 
          onClick={() => handleClick(item)}
          className="p-3 border rounded hover:bg-gray-50 cursor-pointer"
        >
          {item.name} - {item.computedValue}
        </div>
      ))}
    </div>
  );
});

ExpensiveListComponent.displayName = 'ExpensiveListComponent';

// 6. Virtual Scrolling for Large Lists
// components/virtual-list.tsx
import { useState, useEffect, useRef } from 'react';

interface VirtualListProps<T> {
  items: T[];
  itemHeight: number;
  renderItem: (item: T, index: number) => React.ReactNode;
  containerHeight?: number;
}

export function VirtualList<T>({
  items,
  itemHeight,
  renderItem,
  containerHeight = 400
}: VirtualListProps<T>) {
  const [scrollTop, setScrollTop] = useState(0);
  const containerRef = useRef<HTMLDivElement>(null);

  // Calculate visible range
  const visibleStart = Math.floor(scrollTop / itemHeight);
  const visibleEnd = Math.min(
    visibleStart + Math.ceil(containerHeight / itemHeight) + 5, // Buffer
    items.length
  );

  const visibleItems = items.slice(visibleStart, visibleEnd);

  const totalHeight = items.length * itemHeight;
  const offsetTop = visibleStart * itemHeight;

  return (
    <div 
      ref={containerRef}
      className="overflow-y-auto"
      style={{ height: containerHeight }}
      onScroll={(e) => setScrollTop(e.currentTarget.scrollTop)}
    >
      <div style={{ height: totalHeight, position: 'relative' }}>
        <div style={{ 
          position: 'absolute', 
          top: offsetTop,
          width: '100%' 
        }}>
          {visibleItems.map((item, index) => (
            <div 
              key={items[visibleStart + index].id || index} 
              style={{ height: itemHeight }}
            >
              {renderItem(item, visibleStart + index)}
            </div>
          ))}
        </div>
      </div>
    </div>
  );
}

// 7. Resource Optimization Utilities
// lib/resource-optimizer.ts
export class ResourceOptimizer {
  // Memory optimization
  static optimizeMemory() {
    // Clear unnecessary references
    if (global.gc) {
      global.gc();
    }
  }

  // Debounced function execution
  static debounce<T extends (...args: any[]) => any>(
    func: T,
    wait: number
  ): (...args: Parameters<T>) => void {
    let timeout: NodeJS.Timeout;
    return function executedFunction(...args: Parameters<T>) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }

  // Throttled function execution
  static throttle<T extends (...args: any[]) => any>(
    func: T,
    limit: number
  ): (...args: Parameters<T>) => void {
    let inThrottle: boolean;
    return function executedFunction(...args: Parameters<T>) {
      if (!inThrottle) {
        func(...args);
        inThrottle = true;
        setTimeout(() => inThrottle = false, limit);
      }
    };
  }

  // Batch operations to reduce API calls
  static async batchProcess<T, R>(
    items: T[],
    processor: (batch: T[]) => Promise<R[]>,
    batchSize: number = 10
  ): Promise<R[]> {
    const results: R[] = [];
    
    for (let i = 0; i < items.length; i += batchSize) {
      const batch = items.slice(i, i + batchSize);
      const batchResults = await processor(batch);
      results.push(...batchResults);
    }
    
    return results;
  }

  // Lazy initialization pattern
  static lazyInit<T>(initializer: () => T): () => T {
    let instance: T | null = null;
    return () => {
      if (instance === null) {
        instance = initializer();
      }
      return instance;
    };
  }
}

// 8. Image Optimization Component
// components/optimized-image.tsx
import { useState, useEffect } from 'react';

export function OptimizedImage({ 
  src, 
  alt, 
  width, 
  height,
  placeholder = 'data:image/svg+xml;base64,...' // Base64 placeholder
}: {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  placeholder?: string;
}) {
  const [imageSrc, setImageSrc] = useState(placeholder);
  const [loaded, setLoaded] = useState(false);

  useEffect(() => {
    const img = new Image();
    img.onload = () => {
      setImageSrc(src);
      setLoaded(true);
    };
    img.src = src;
  }, [src]);

  return (
    <img
      src={imageSrc}
      alt={alt}
      width={width}
      height={height}
      className={`transition-opacity duration-300 ${loaded ? 'opacity-100' : 'opacity-0'}`}
    />
  );
}

// 9. Web Worker for Heavy Computations
// lib/computation-worker.ts
export class ComputationWorker {
  private worker: Worker | null = null;
  private callbacks: Map<number, (result: any) => void> = new Map();
  private messageId: number = 0;

  constructor(workerUrl: string) {
    if (typeof Worker !== 'undefined') {
      this.worker = new Worker(workerUrl);
      this.worker.onmessage = (event) => {
        const { id, result } = event.data;
        const callback = this.callbacks.get(id);
        if (callback) {
          callback(result);
          this.callbacks.delete(id);
        }
      };
    }
  }

  async compute(task: string, data: any): Promise<any> {
    if (!this.worker) {
      // Fallback to main thread if Web Workers not supported
      return this.fallbackCompute(task, data);
    }

    return new Promise((resolve) => {
      const id = ++this.messageId;
      this.callbacks.set(id, resolve);
      this.worker!.postMessage({ id, task, data });
    });
  }

  private async fallbackCompute(task: string, data: any): Promise<any> {
    // Perform computation on main thread
    switch (task) {
      case 'graph-analysis':
        return this.performGraphAnalysis(data);
      case 'code-processing':
        return this.performCodeProcessing(data);
      default:
        throw new Error(`Unknown task: ${task}`);
    }
  }

  private performGraphAnalysis(data: any) {
    // Heavy graph computation
    return data; // Simplified for example
  }

  private performCodeProcessing(data: any) {
    // Heavy code processing
    return data; // Simplified for example
  }

  destroy() {
    if (this.worker) {
      this.worker.terminate();
      this.worker = null;
    }
    this.callbacks.clear();
  }
}

// 10. Performance Monitoring Hook
// hooks/use-performance.ts
import { useState, useEffect, useRef } from 'react';

export function usePerformanceTracking(componentName: string) {
  const [renderCount, setRenderCount] = useState(0);
  const renderStartTime = useRef<number | null>(null);
  const renderEndTime = useRef<number | null>(null);

  useEffect(() => {
    setRenderCount(prev => prev + 1);
    renderStartTime.current = performance.now();
    
    return () => {
      renderEndTime.current = performance.now();
      if (renderStartTime.current && renderEndTime.current) {
        const duration = renderEndTime.current - renderStartTime.current;
        if (duration > 16.67) { // More than one frame at 60fps
          console.warn(`${componentName} took ${duration.toFixed(2)}ms to render`);
        }
      }
    };
  });

  const getPerformanceMetrics = () => ({
    componentName,
    renderCount,
    lastRenderTime: renderEndTime.current ? 
      (renderEndTime.current - (renderStartTime.current || 0)).toFixed(2) + 'ms' : 
      'N/A'
  });

  return { renderCount, getPerformanceMetrics };
}
