# Performance Optimization & Caching Patterns
## Ultra-Dex Cursor Rule 31-performance.mdc

### Context
Modern SaaS applications require aggressive performance optimization to compete. Caching, parallel processing, and resource optimization are essential for providing fast, responsive experiences at scale.

### Pattern
```javascript
// 1. Multi-layer Caching System
// lib/cache-manager.ts
import NodeCache from 'node-cache';
import { Redis } from 'ioredis';
import { LRUCache } from 'lru-cache';

export class CacheManager {
  private memoryCache: NodeCache;
  private redisClient?: Redis;
  private lruCache: LRUCache<string, any>;

  constructor(options: {
    redisUrl?: string;
    memoryTTL?: number; // seconds
    lruMax?: number;
  } = {}) {
    // In-memory cache (fastest)
    this.memoryCache = new NodeCache({ 
      stdTTL: options.memoryTTL || 300, // 5 minutes default
      checkperiod: 120 // Check for expired every 2 minutes
    });

    // LRU cache (memory constrained)
    this.lruCache = new LRUCache({
      max: options.lruMax || 1000,
      ttl: 300000, // 5 minutes in ms
      allowStale: false,
      updateAgeOnGet: true,
      updateAgeOnHas: true
    });

    // Redis cache (distributed/shared)
    if (options.redisUrl) {
      this.redisClient = new Redis(options.redisUrl);
    }
  }

  async get<T>(key: string): Promise<T | undefined> {
    // Try memory cache first (fastest)
    const memoryResult = this.memoryCache.get<T>(key);
    if (memoryResult !== undefined) {
      return memoryResult;
    }

    // Try LRU cache
    const lruResult = this.lruCache.get(key);
    if (lruResult !== undefined) {
      return lruResult as T;
    }

    // Try Redis cache if available
    if (this.redisClient) {
      try {
        const redisResult = await this.redisClient.get(key);
        if (redisResult) {
          const parsed = JSON.parse(redisResult);
          // Update local caches
          this.memoryCache.set(key, parsed);
          this.lruCache.set(key, parsed);
          return parsed;
        }
      } catch (error) {
        console.warn('Redis cache error:', error.message);
      }
    }

    return undefined;
  }

  async set<T>(key: string, value: T, ttl?: number): Promise<boolean> {
    // Set in all cache layers
    const setResult = this.memoryCache.set(key, value, ttl);
    this.lruCache.set(key, value);
    
    if (this.redisClient) {
      try {
        await this.redisClient.setex(key, ttl || 300, JSON.stringify(value));
      } catch (error) {
        console.warn('Redis cache set error:', error.message);
      }
    }

    return setResult;
  }

  async invalidate(pattern: string): Promise<void> {
    // Invalidate memory cache
    const keys = this.memoryCache.keys().filter(k => k.includes(pattern));
    keys.forEach(k => this.memoryCache.del(k));
    
    // Invalidate LRU cache
    if (pattern === '*') {
      this.lruCache.clear();
    } else {
      // For specific patterns, we'd need to track key mappings
      // This is a simplified approach
      this.lruCache.delete(pattern);
    }
    
    // Invalidate Redis cache
    if (this.redisClient) {
      try {
        const redisKeys = await this.redisClient.keys(`*${pattern}*`);
        if (redisKeys.length > 0) {
          await this.redisClient.del(redisKeys);
        }
      } catch (error) {
        console.warn('Redis cache invalidate error:', error.message);
      }
    }
  }

  async clear(): Promise<void> {
    this.memoryCache.flushAll();
    this.lruCache.clear();
    
    if (this.redisClient) {
      try {
        await this.redisClient.flushdb();
      } catch (error) {
        console.warn('Redis cache clear error:', error.message);
      }
    }
  }
}

// 2. Performance Monitoring Decorator
// lib/performance-monitor.ts
import { monitoring } from './monitoring.js';

export function performanceTrack(operation: string) {
  return function(target: any, propertyKey: string, descriptor: PropertyDescriptor) {
    const originalMethod = descriptor.value;

    descriptor.value = async function(...args: any[]) {
      const start = performance.now();
      const startTime = Date.now();
      
      try {
        const result = await originalMethod.apply(this, args);
        
        const duration = performance.now() - start;
        monitoring.recordPerformance(operation, {
          duration,
          startTime: new Date(startTime).toISOString(),
          endTime: new Date().toISOString(),
          success: true,
          args: args.length > 0 ? args[0] : undefined
        });
        
        return result;
      } catch (error) {
        const duration = performance.now() - start;
        monitoring.recordPerformance(operation, {
          duration,
          startTime: new Date(startTime).toISOString(),
          endTime: new Date().toISOString(),
          success: false,
          error: error.message,
          args: args.length > 0 ? args[0] : undefined
        });
        
        throw error;
      }
    };

    return descriptor;
  };
}

// 3. Parallel Processing with Rate Limiting
// lib/parallel-processor.ts
export class ParallelProcessor {
  private queue: Array<() => Promise<any>> = [];
  private processing: number = 0;
  private maxConcurrent: number;

  constructor(maxConcurrent: number = 5) {
    this.maxConcurrent = maxConcurrent;
  }

  async add<T>(task: () => Promise<T>): Promise<T> {
    return new Promise<T>((resolve, reject) => {
      this.queue.push(async () => {
        try {
          const result = await task();
          resolve(result);
        } catch (error) {
          reject(error);
        } finally {
          this.processing--;
          this.processNext();
        }
      });
      
      this.processNext();
    });
  }

  private async processNext(): Promise<void> {
    if (this.processing >= this.maxConcurrent || this.queue.length === 0) {
      return;
    }

    this.processing++;
    const task = this.queue.shift();
    if (task) {
      await task();
    }
  }

  async processAll<T>(tasks: Array<() => Promise<T>>): Promise<T[]> {
    const results: T[] = [];
    const errors: Error[] = [];
    
    // Process in batches to respect concurrency limits
    const batchSize = this.maxConcurrent;
    
    for (let i = 0; i < tasks.length; i += batchSize) {
      const batch = tasks.slice(i, i + batchSize);
      const batchPromises = batch.map(task => this.add(task));
      
      try {
        const batchResults = await Promise.allSettled(batchPromises);
        
        for (const result of batchResults) {
          if (result.status === 'fulfilled') {
            results.push(result.value);
          } else {
            errors.push(result.reason);
            console.error('Batch task failed:', result.reason);
          }
        }
      } catch (error) {
        console.error('Batch processing error:', error);
      }
    }

    if (errors.length > 0) {
      console.warn(`Completed with ${errors.length} errors out of ${tasks.length} tasks`);
    }

    return results;
  }
}

