# Cron Jobs & Scheduled Tasks Pattern
## Ultra-Dex Cursor Rule 19-cron-jobs.mdc

### Context
Scheduled tasks are essential for recurring operations like data cleanup, notifications, analytics, and maintenance. Proper implementation ensures reliability and scalability.

### Pattern
```javascript
// 1. Cron job scheduler with distributed locking
import { CronJob } from 'cron';
import { redis } from './lib/redis.js';

class JobScheduler {
  constructor() {
    this.jobs = new Map();
    this.runningJobs = new Set();
  }

  async scheduleJob(name, cronExpression, task, options = {}) {
    // Distributed lock to prevent duplicate execution
    const lockKey = `job-lock:${name}`;
    const lockTimeout = options.lockTimeout || 300; // 5 minutes
    
    const job = new CronJob(cronExpression, async () => {
      const lockAcquired = await this.acquireLock(lockKey, lockTimeout);
      
      if (!lockAcquired) {
        console.log(`Job ${name} already running, skipping`);
        return;
      }

      try {
        console.log(`Starting job: ${name}`);
        this.runningJobs.add(name);
        
        await task();
        
        console.log(`Completed job: ${name}`);
      } catch (error) {
        console.error(`Job ${name} failed:`, error);
        // Optionally notify error monitoring system
        await this.handleJobError(name, error);
      } finally {
        this.runningJobs.delete(name);
        await this.releaseLock(lockKey);
      }
    });

    this.jobs.set(name, job);
    job.start();
  }

  async acquireLock(key, timeoutSeconds) {
    const lockValue = `${Date.now() + timeoutSeconds * 1000}`;
    const result = await redis.set(key, lockValue, 'EX', timeoutSeconds, 'NX');
    return result === 'OK';
  }

  async releaseLock(key) {
    await redis.del(key);
  }

  async handleJobError(jobName, error) {
    // Log error and potentially send to monitoring
    console.error(`Job ${jobName} error:`, error);
    
    // Increment error counter
    await redis.incr(`job-errors:${jobName}:${new Date().toISOString().split('T')[0]}`);
  }
}

// 2. Background job queue for heavy tasks
import Queue from 'bull';

const backgroundQueue = new Queue('background jobs', process.env.REDIS_URL);

// Process jobs with concurrency control
backgroundQueue.process('heavy-task', 5, async (job) => { // Max 5 concurrent
  const { data, userId, priority } = job.data;
  
  // Process the task
  const result = await heavyTaskProcessor(data, userId);
  
  return result;
});

// 3. Job scheduling with retry and backoff
export async function scheduleTask(taskName, payload, delay = 0) {
  const job = await backgroundQueue.add(taskName, payload, {
    delay, // Delay in milliseconds
    attempts: 3, // Retry 3 times
    backoff: {
      type: 'exponential',
      delay: 2000 // Start with 2s, then 4s, 8s
    },
    priority: 'normal' // low, normal, medium, high, critical
  });

  return job.id;
}

// 4. Job monitoring and health checks
export async function getJobStats() {
  const waiting = await backgroundQueue.getWaitingCount();
  const active = await backgroundQueue.getActiveCount();
  const completed = await backgroundQueue.getCompletedCount();
  const failed = await backgroundQueue.getFailedCount();
  
  return { waiting, active, completed, failed };
}
```

### Production Considerations
- **Reliability**: Implement distributed locks to prevent duplicate execution across instances
- **Monitoring**: Track job success/failure rates, execution times, and queue lengths
- **Error Handling**: Retry with exponential backoff and dead letter queues for failures
- **Scalability**: Use background job queues with worker pools for heavy tasks
- **Observability**: Log job execution with correlation IDs for tracing

### Anti-Patterns to Avoid
- ❌ Running long tasks synchronously in cron jobs (causes timeouts)
- ❌ No distributed locking (duplicate execution in multi-instance setups)
- ❌ No error handling or retry logic (permanent failures)
- ❌ No monitoring or alerting (unnoticed failures)
- ❌ Storing large payloads in job queues (performance issues)

