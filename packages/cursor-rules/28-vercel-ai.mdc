// 6. Rate Limiting for AI Usage
// middleware/ai-rate-limit.ts
import { kv } from '@vercel/kv';
import { NextRequest, NextResponse } from 'next/server';

const RATE_LIMITS = {
  free: { requests: 10, window: 60 * 60 }, // 10 requests per hour
  pro: { requests: 100, window: 60 * 60 }, // 100 requests per hour
  team: { requests: 1000, window: 60 * 60 } // 1000 requests per hour
};

export async function checkAIRateLimit(userId: string, tenantId: string): Promise<{ allowed: boolean; resetTime?: number }> {
  const key = `ai_rate_limit:${tenantId}:${userId}`;
  const window = RATE_LIMITS.pro.window; // Default to pro plan
  
  const [requests, resetTime] = await kv.pipeline()
    .incr(key)
    .expire(key, window)
    .exec() as [number, number];

  if (requests > RATE_LIMITS.pro.requests) {
    return { allowed: false, resetTime };
  }

  return { allowed: true };
}

// 7. Error Recovery for AI Streams
// lib/ai-stream-recovery.ts
export class AIStreamRecovery {
  private retryCount: number = 0;
  private maxRetries: number = 3;

  async executeWithRecovery(operation: () => Promise<any>, context: any = {}) {
    while (this.retryCount < this.maxRetries) {
      try {
        const result = await operation();
        this.retryCount = 0; // Reset on success
        return result;
      } catch (error) {
        this.retryCount++;
        
        if (this.retryCount >= this.maxRetries) {
          throw new Error(`Operation failed after ${this.maxRetries} retries: ${error.message}`);
        }

        // Exponential backoff
        const delay = Math.pow(2, this.retryCount) * 1000;
        await new Promise(resolve => setTimeout(resolve, delay));
        
        console.warn(`Retry ${this.retryCount}/${this.maxRetries} for operation:`, error.message);
      }
    }
  }
}

// 8. Cost Tracking for AI Usage
// lib/ai-cost-tracking.ts
export class AICostTracker {
  private costs = {
    openai: {
      'gpt-4-turbo': { input: 0.01, output: 0.03 }, // per 1k tokens
      'gpt-4': { input: 0.03, output: 0.06 },
    },
    anthropic: {
      'claude-3-5-sonnet': { input: 0.003, output: 0.015 },
      'claude-3-opus': { input: 0.015, output: 0.075 },
    }
  };

  calculateCost(model: string, inputTokens: number, outputTokens: number): number {
    const [provider, modelName] = model.split('/');
    const cost = this.costs[provider]?.[modelName];
    
    if (!cost) {
      return 0; // Unknown model, no cost tracking
    }

    const inputCost = (inputTokens / 1000) * cost.input;
    const outputCost = (outputTokens / 1000) * cost.output;
    
    return inputCost + outputCost;
  }

  async trackUsage(userId: string, tenantId: string, model: string, usage: { input: number, output: number }) {
    const cost = this.calculateCost(model, usage.input, usage.output);
    
    await db.aiUsage.create({
      data: {
        userId,
        tenantId,
        model,
        inputTokens: usage.input,
        outputTokens: usage.output,
        cost,
        timestamp: new Date()
      }
    });
  }
}
```

### Production Considerations
- **Streaming**: Use proper React streaming with Suspense boundaries
- **Tool Validation**: Always validate tool inputs with Zod
- **Rate Limiting**: Implement per-tenant rate limiting
- **Cost Tracking**: Monitor and track AI usage costs
- **Error Recovery**: Handle streaming interruptions gracefully

### Anti-Patterns to Avoid
- ❌ Not validating tool inputs (security risk)
- ❌ Unlimited tool usage (could be expensive)
- ❌ No rate limiting for AI requests
- ❌ Not tracking AI costs
- ❌ Blocking UI during streaming

### Quality Gates
- [ ] All tools validated with Zod schemas
- [ ] Rate limiting implemented per tenant
- [ ] Cost tracking enabled for all models
- [ ] Error recovery for streaming
- [ ] Proper streaming UX with loading states
- [ ] Tool usage analytics tracking