# Configuration Management & Environment Patterns
## Ultra-Dex Cursor Rule 25-config-env.mdc

### Context
Proper configuration management is essential for deploying applications across different environments while maintaining security and flexibility. This pattern ensures secure handling of environment variables and configuration values.

### Pattern
```javascript
// 1. Comprehensive configuration manager
import fs from 'fs/promises';
import path from 'path';
import dotenv from 'dotenv';
import Ajv from 'ajv';
import addFormats from 'ajv-formats';
import { cosmiconfig } from 'cosmiconfig';

const ajv = new Ajv();
addFormats(ajv);

class ConfigurationManager {
  constructor(options = {}) {
    this.config = {};
    this.schema = options.schema || this.getDefaultSchema();
    this.validator = ajv.compile(this.schema);
    this.configDirs = options.configDirs || ['.ultra-dex', '.config', 'config'];
    this.configFiles = options.configFiles || [
      'ultra-dex.config.json',
      'ultra-dex.config.js',
      '.ultra-dex.json',
      '.ultra-dexrc',
      'package.json'
    ];
  }

  getDefaultSchema() {
    return {
      type: 'object',
      properties: {
        ai: {
          type: 'object',
          properties: {
            defaultProvider: { type: 'string', enum: ['claude', 'openai', 'gemini', 'ollama'] },
            temperature: { type: 'number', minimum: 0, maximum: 1 },
            maxTokens: { type: 'number', minimum: 100, maximum: 8192 }
          },
          required: ['defaultProvider']
        },
        mcp: {
          type: 'object',
          properties: {
            port: { type: 'number', minimum: 1, maximum: 65535 },
            host: { type: 'string' },
            timeout: { type: 'number', minimum: 1000 }
          },
          required: ['port']
        },
        performance: {
          type: 'object',
          properties: {
            cacheEnabled: { type: 'boolean' },
            maxConcurrentTasks: { type: 'number', minimum: 1, maximum: 20 },
            graphScanInterval: { type: 'number', minimum: 1000 }
          }
        },
        security: {
          type: 'object',
          properties: {
            validatePaths: { type: 'boolean' },
            allowExternalConnections: { type: 'boolean' },
            maxFileSize: { type: 'number' }
          }
        }
      }
    };
  }

  async load() {
    // 1. Load environment variables first
    await this.loadEnvironmentVariables();
    
    // 2. Load configuration files
    const configFile = await this.findConfigFile();
    if (configFile) {
      await this.loadConfigFile(configFile);
    }
    
    // 3. Apply environment variable overrides
    this.applyEnvironmentOverrides();
    
    // 4. Validate configuration
    if (!this.validate()) {
      throw new Error('Configuration validation failed');
    }
    
    return this.config;
  }

  async loadEnvironmentVariables() {
    // Load from multiple .env files based on NODE_ENV
    const envFiles = [
      '.env',
      `.env.${process.env.NODE_ENV}`,
      '.env.local',
      '.env.defaults'
    ];

    for (const file of envFiles) {
      const envPath = path.resolve(process.cwd(), file);
      if (await this.fileExists(envPath)) {
        const envConfig = dotenv.parse(await fs.readFile(envPath));
        for (const [key, value] of Object.entries(envConfig)) {
          if (!(key in process.env)) {
            process.env[key] = value;
          }
        }
      }
    }
  }

  async findConfigFile() {
    for (const dir of this.configDirs) {
      for (const file of this.configFiles) {
        const fullPath = path.resolve(process.cwd(), dir, file);
        if (await this.fileExists(fullPath)) {
          return fullPath;
        }
      }
    }
    
    // Check root directory
    for (const file of this.configFiles) {
      const fullPath = path.resolve(process.cwd(), file);
      if (await this.fileExists(fullPath)) {
        return fullPath;
      }
    }
    
    return null;
  }

  async loadConfigFile(configPath) {
    const explorer = cosmiconfig('ultra-dex');
    const result = await explorer.load(configPath);
    
    if (result) {
      this.config = { ...this.config, ...result.config };
    }
  }

  applyEnvironmentOverrides() {
    // AI provider settings
    if (process.env.AI_DEFAULT_PROVIDER) {
      this.config.ai = this.config.ai || {};
      this.config.ai.defaultProvider = process.env.AI_DEFAULT_PROVIDER;
    }
    
    if (process.env.AI_TEMPERATURE) {
      this.config.ai = this.config.ai || {};
      this.config.ai.temperature = parseFloat(process.env.AI_TEMPERATURE);
    }
    
    // MCP settings
    if (process.env.MCP_PORT) {
      this.config.mcp = this.config.mcp || {};
      this.config.mcp.port = parseInt(process.env.MCP_PORT);
    }
    
    if (process.env.MCP_HOST) {
      this.config.mcp = this.config.mcp || {};
      this.config.mcp.host = process.env.MCP_HOST;
    }
    
    // Performance settings
    if (process.env.PERFORMANCE_CACHE_ENABLED) {
      this.config.performance = this.config.performance || {};
      this.config.performance.cacheEnabled = process.env.PERFORMANCE_CACHE_ENABLED === 'true';
    }
    
    if (process.env.PERFORMANCE_MAX_CONCURRENT_TASKS) {
      this.config.performance = this.config.performance || {};
      this.config.performance.maxConcurrentTasks = parseInt(process.env.PERFORMANCE_MAX_CONCURRENT_TASKS);
    }
    
    // Security settings
    if (process.env.SECURITY_VALIDATE_PATHS !== undefined) {
      this.config.security = this.config.security || {};
      this.config.security.validatePaths = process.env.SECURITY_VALIDATE_PATHS === 'true';
    }
  }

  validate() {
    const valid = this.validator(this.config);
    if (!valid) {
      console.error('Configuration validation errors:', this.validator.errors);
    }
    return valid;
  }

  get(path, defaultValue = undefined) {
    const keys = path.split('.');
    let value = this.config;
    
    for (const key of keys) {
      if (value === null || value === undefined) {
        return defaultValue;
      }
      value = value[key];
    }
    
    return value !== undefined ? value : defaultValue;
  }

  set(path, value) {
    const keys = path.split('.');
    let current = this.config;
    
    for (let i = 0; i < keys.length - 1; i++) {
      const key = keys[i];
      if (current[key] === undefined || current[key] === null) {
        current[key] = {};
      }
      current = current[key];
    }
    
    current[keys[keys.length - 1]] = value;
  }

  async save(config = this.config) {
    const configPath = path.resolve(process.cwd(), '.ultra-dex', 'config.json');
    await fs.mkdir(path.dirname(configPath), { recursive: true });
    await fs.writeFile(configPath, JSON.stringify(config, null, 2));
    return true;
  }

  async fileExists(filePath) {
    try {
      await fs.access(filePath);
      return true;
    } catch {
      return false;
    }
  }

  // 2. Secure environment variable handling
  static validateEnvironment() {
    const requiredEnvVars = [
      'NODE_ENV',
      'PORT'
    ];
    
    const missing = [];
    for (const envVar of requiredEnvVars) {
      if (!process.env[envVar]) {
        missing.push(envVar);
      }
    }
    
    if (missing.length > 0) {
      console.warn(`Missing required environment variables: ${missing.join(', ')}`);
    }
    
    // Validate sensitive environment variables are not exposed
    const sensitiveVars = [
      'API_KEY',
      'SECRET_KEY',
      'PASSWORD',
      'TOKEN',
      'PRIVATE_KEY'
    ];
    
    for (const [key, value] of Object.entries(process.env)) {
      if (sensitiveVars.some(sensitive => key.toLowerCase().includes(sensitive.toLowerCase()))) {
        if (value && value.length > 0 && !value.startsWith('***')) {
          // Mask sensitive values in logs
          process.env[key] = `***${value.slice(-4)}`;
        }
      }
    }
  }

  // 3. Configuration encryption for sensitive values
  static encryptConfig(config, password) {
    const crypto = await import('crypto');
    const algorithm = 'aes-256-gcm';
    
    const iv = crypto.randomBytes(16);
    const cipher = crypto.createCipher(algorithm, password);
    cipher.setAAD(Buffer.from('ultra-dex-config'));
    
    let encrypted = cipher.update(JSON.stringify(config), 'utf8', 'hex');
    encrypted += cipher.final('hex');
    
    const authTag = cipher.getAuthTag();
    
    return {
      encrypted,
      iv: iv.toString('hex'),
      authTag: authTag.toString('hex')
    };
  }

  static decryptConfig(encryptedData, password) {
    const crypto = await import('crypto');
    const algorithm = 'aes-256-gcm';
    
    const decipher = crypto.createDecipher(algorithm, password);
    decipher.setAAD(Buffer.from('ultra-dex-config'));
    decipher.setAuthTag(Buffer.from(encryptedData.authTag, 'hex'));
    
    let decrypted = decipher.update(encryptedData.encrypted, 'hex', 'utf8');
    decrypted += decipher.final('utf8');
    
    return JSON.parse(decrypted);
  }
}

// 4. Environment-specific configuration loader
class EnvironmentConfigLoader {
  constructor() {
    this.environment = process.env.NODE_ENV || 'development';
    this.configManager = new ConfigurationManager();
  }

  async load() {
    // Load base configuration
    const baseConfig = await this.configManager.load();
    
    // Load environment-specific overrides
    const envOverrides = await this.loadEnvironmentOverrides();
    
    // Merge configurations
    const finalConfig = this.deepMerge(baseConfig, envOverrides);
    
    // Apply runtime environment variables
    this.applyRuntimeOverrides(finalConfig);
    
    return finalConfig;
  }

  async loadEnvironmentOverrides() {
    const envConfigPath = path.resolve(
      process.cwd(), 
      '.ultra-dex', 
      `config.${this.environment}.json`
    );
    
    try {
      if (await this.configManager.fileExists(envConfigPath)) {
        const envConfig = JSON.parse(await fs.readFile(envConfigPath, 'utf8'));
        return envConfig;
      }
    } catch (error) {
      console.warn(`Failed to load environment config ${this.environment}:`, error.message);
    }
    
    return {};
  }

  applyRuntimeOverrides(config) {
    // Apply runtime environment variables that take highest precedence
    if (process.env.RUNTIME_OVERRIDE) {
      try {
        const overrides = JSON.parse(process.env.RUNTIME_OVERRIDE);
        Object.assign(config, overrides);
      } catch (error) {
        console.warn('Invalid RUNTIME_OVERRIDE format:', error.message);
      }
    }
  }

  deepMerge(target, source) {
    const output = { ...target };
    
    if (this.isObject(target) && this.isObject(source)) {
      Object.keys(source).forEach(key => {
        if (this.isObject(source[key])) {
          if (!(key in target)) {
            Object.assign(output, { [key]: source[key] });
          } else {
            output[key] = this.deepMerge(target[key], source[key]);
          }
        } else {
          Object.assign(output, { [key]: source[key] });
        }
      });
    }
    
    return output;
  }

  isObject(item) {
    return (item && typeof item === 'object' && !Array.isArray(item));
  }
}

// 5. Configuration validation middleware
export function createConfigValidationMiddleware(configManager) {
  return async (req, res, next) => {
    try {
      // Validate request against configuration constraints
      const aiProvider = configManager.get('ai.defaultProvider');
      const maxTokens = configManager.get('ai.maxTokens', 8192);
      const rateLimit = configManager.get('performance.rateLimit', 100);
      
      // Store validated config in request context
      req.config = {
        ai: { provider: aiProvider, maxTokens },
        performance: { rateLimit }
      };
      
      next();
    } catch (error) {
      res.status(500).json({ 
        error: 'Configuration validation failed',
        message: error.message 
      });
    }
  };
}

// 6. Configuration change monitoring
class ConfigWatcher {
  constructor(configManager) {
    this.configManager = configManager;
    this.watchers = new Map();
    this.callbacks = new Map();
  }

  async watch(configPath, callback) {
    const watcherId = crypto.randomUUID();
    
    // Watch for changes to config files
    const watcher = fs.watch(configPath, (eventType, filename) => {
      if (eventType === 'change') {
        callback(configPath);
      }
    });
    
    this.watchers.set(watcherId, watcher);
    this.callbacks.set(watcherId, callback);
    
    return watcherId;
  }

  unwatch(watcherId) {
    const watcher = this.watchers.get(watcherId);
    if (watcher) {
      watcher.close();
      this.watchers.delete(watcherId);
      this.callbacks.delete(watcherId);
    }
  }

  async reloadConfig() {
    const newConfig = await this.configManager.load();
    
    // Notify all subscribers of config change
    for (const callback of this.callbacks.values()) {
      callback(newConfig);
    }
    
    return newConfig;
  }
}

// 7. Configuration export/import utilities
export class ConfigExporter {
  static async exportConfig(config, format = 'json') {
    switch (format.toLowerCase()) {
      case 'json':
        return JSON.stringify(config, null, 2);
      
      case 'yaml':
        const yaml = await import('yaml');
        return yaml.stringify(config);
      
      case 'env':
        return this.toEnvFormat(config);
      
      case 'toml':
        const toml = await import('@iarna/toml');
        return toml.stringify(config);
      
      default:
        throw new Error(`Unsupported format: ${format}`);
    }
  }

  static toEnvFormat(config, prefix = '') {
    let envString = '';
    
    for (const [key, value] of Object.entries(config)) {
      const fullKey = prefix ? `${prefix}_${key.toUpperCase()}` : key.toUpperCase();
      
      if (typeof value === 'object' && value !== null && !Array.isArray(value)) {
        envString += this.toEnvFormat(value, fullKey) + '\n';
      } else {
        envString += `${fullKey}=${value}\n`;
      }
    }
    
    return envString;
  }

  static async importConfig(configString, format = 'json') {
    switch (format.toLowerCase()) {
      case 'json':
        return JSON.parse(configString);
      
      case 'yaml':
        const yaml = await import('yaml');
        return yaml.parse(configString);
      
      case 'env':
        return this.fromEnvFormat(configString);
      
      case 'toml':
        const toml = await import('@iarna/toml');
        return toml.parse(configString);
      
      default:
        throw new Error(`Unsupported format: ${format}`);
    }
  }

  static fromEnvFormat(envString) {
    const config = {};
    const lines = envString.split('\n');
    
    for (const line of lines) {
      if (line.trim() && !line.startsWith('#')) {
        const [key, ...valueParts] = line.split('=');
        const value = valueParts.join('=').trim();
        
        // Convert key back to nested object structure
        this.setNestedValue(config, key.toLowerCase(), value);
      }
    }
    
    return config;
  }

  static setNestedValue(obj, key, value) {
    const parts = key.split('_');
    let current = obj;
    
    for (let i = 0; i < parts.length - 1; i++) {
      const part = parts[i].toLowerCase();
      if (!current[part]) {
        current[part] = {};
      }
      current = current[part];
    }
    
    const lastPart = parts[parts.length - 1].toLowerCase();
    // Try to convert string values to appropriate types
    current[lastPart] = this.convertValueType(value);
  }

  static convertValueType(value) {
    if (value === 'true') return true;
    if (value === 'false') return false;
    if (/^\d+$/.test(value)) return parseInt(value);
    if (/^\d*\.\d+$/.test(value)) return parseFloat(value);
    return value;
  }
}

// 8. Default configuration instance
export const configManager = new EnvironmentConfigLoader();

// 9. Async initialization
export async function initializeConfig() {
  try {
    const config = await configManager.load();
    console.log('✅ Configuration loaded successfully');
    return config;
  } catch (error) {
    console.error('❌ Configuration loading failed:', error.message);
    throw error;
  }
}

// 10. Configuration validation utility
export function validateConfigSchema(config, schema) {
  const validator = ajv.compile(schema);
  const valid = validator(config);
  
  if (!valid) {
    const errors = validator.errors.map(err => ({
      path: err.instancePath || err.params?.missingProperty,
      message: err.message,
      value: err.params?.allowedValue || err.params?.comparison
    }));
    
    return { valid: false, errors };
  }
  
  return { valid: true, errors: [] };
}
