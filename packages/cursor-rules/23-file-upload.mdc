# File Upload & Storage Pattern
## Ultra-Dex Cursor Rule 23-file-upload.mdc

### Context
Secure file upload handling is critical for applications accepting user-generated content. Proper implementation prevents security vulnerabilities while maintaining performance and reliability.

### Pattern
```javascript
// 1. Secure file upload handler with validation
import multer from 'multer';
import path from 'path';
import fs from 'fs/promises';
import { pipeline } from 'stream/promises';
import { createReadStream, createWriteStream } from 'fs';
import sharp from 'sharp'; // For image processing
import { v4 as uuidv4 } from 'uuid';
import { validateMimeType, getFileSize, virusScan } from './lib/security.js';

// 2. Multer configuration with security validations
const storage = multer.diskStorage({
  destination: async (req, file, cb) => {
    try {
      // Validate file type before determining destination
      const isValidType = validateMimeType(file.mimetype, file.originalname);
      if (!isValidType) {
        return cb(new Error('Invalid file type'), false);
      }

      // Create secure upload directory
      const uploadDir = path.join(process.cwd(), '.ultra-dex', 'uploads', new Date().getFullYear().toString(), (new Date().getMonth() + 1).toString());
      await fs.mkdir(uploadDir, { recursive: true });
      
      cb(null, uploadDir);
    } catch (error) {
      cb(error, false);
    }
  },
  filename: (req, file, cb) => {
    // Generate secure filename to prevent path traversal
    const ext = path.extname(file.originalname).toLowerCase();
    const uniqueName = `${uuidv4()}${ext}`;
    cb(null, uniqueName);
  }
});

// 3. File upload validation middleware
const fileUploadValidator = {
  // Size validation
  maxSize: 10 * 1024 * 1024, // 10MB limit
  
  // Type validation
  allowedTypes: [
    'image/jpeg', 'image/png', 'image/gif', 'image/webp', // Images
    'application/pdf', 'text/plain', 'text/csv', // Documents
    'application/json', 'application/zip', // Data/Archive
    'text/markdown', 'text/md' // Markdown
  ],

  // Custom validation function
  validate: async (file) => {
    const errors = [];

    // Check file size
    if (file.size > this.maxSize) {
      errors.push(`File size exceeds limit (${this.maxSize / 1024 / 1024}MB)`);
    }

    // Check file type
    if (!this.allowedTypes.includes(file.mimetype)) {
      errors.push(`File type not allowed: ${file.mimetype}`);
    }

    // Additional security checks
    if (file.originalname.includes('..') || file.originalname.includes('/')) {
      errors.push('Invalid filename containing path traversal');
    }

    // Check for magic bytes to verify file type
    const buffer = await fs.readFile(file.path);
    const actualMimeType = await detectMimeType(buffer);
    if (actualMimeType !== file.mimetype) {
      errors.push('File type mismatch - possible file extension spoofing');
    }

    return {
      valid: errors.length === 0,
      errors
    };
  }
};

// 4. Secure upload middleware
export const secureUpload = multer({
  storage,
  limits: {
    fileSize: fileUploadValidator.maxSize,
    files: 5 // Max 5 files per request
  },
  fileFilter: (req, file, cb) => {
    fileUploadValidator.validate(file)
      .then(result => {
        if (result.valid) {
          cb(null, true);
        } else {
          cb(new Error(result.errors.join(', ')), false);
        }
      })
      .catch(error => {
        cb(error, false);
      });
  }
}).any(); // Accept any field names

// 5. Virus scanning and security processing
async function processUploadedFile(filePath, options = {}) {
  const { 
    virusScan: scanVirus = true, 
    imageOptimization = true,
    extractMetadata = true 
  } = options;

  const fileInfo = {
    path: filePath,
    size: await getFileSize(filePath),
    mimeType: await detectMimeType(fs.readFileSync(filePath)),
    sha256: await calculateSHA256(filePath),
    uploadedAt: new Date().toISOString()
  };

  // Security scan
  if (scanVirus) {
    const scanResult = await virusScan(filePath);
    if (!scanResult.clean) {
      throw new Error(`Virus detected in file: ${scanResult.threats.join(', ')}`);
    }
  }

  // Image optimization
  if (imageOptimization && isImageFile(fileInfo.mimeType)) {
    await optimizeImage(filePath);
  }

  // Extract metadata
  if (extractMetadata) {
    fileInfo.metadata = await extractFileMetadata(filePath);
  }

  return fileInfo;
}

// 6. Cloud storage integration (AWS S3 example)
import { S3Client, PutObjectCommand, DeleteObjectCommand } from '@aws-sdk/client-s3';

class CloudStorageManager {
  constructor() {
    this.s3 = new S3Client({
      region: process.env.AWS_REGION,
      credentials: {
        accessKeyId: process.env.AWS_ACCESS_KEY_ID,
        secretAccessKey: process.env.AWS_SECRET_ACCESS_KEY
      }
    });
    this.bucket = process.env.AWS_S3_BUCKET;
  }

  async uploadFile(localPath, options = {}) {
    const { 
      key = `uploads/${uuidv4()}/${path.basename(localPath)}`,
      contentType = 'application/octet-stream',
      acl = 'private' // Default to private
    } = options;

    const fileContent = await fs.readFile(localPath);
    
    const command = new PutObjectCommand({
      Bucket: this.bucket,
      Key: key,
      Body: fileContent,
      ContentType: contentType,
      ACL: acl,
      Metadata: {
        originalName: path.basename(localPath),
        uploadedAt: new Date().toISOString(),
        uploaderId: options.userId || 'anonymous'
      }
    });

    await this.s3.send(command);
    
    return {
      key,
      url: `https://${this.bucket}.s3.${process.env.AWS_REGION}.amazonaws.com/${key}`,
      size: fileContent.length
    };
  }

  async deleteFile(key) {
    const command = new DeleteObjectCommand({
      Bucket: this.bucket,
      Key: key
    });

    await this.s3.send(command);
  }

  async generatePresignedUrl(key, expiresIn = 3600) {
    // Implementation for presigned URLs
    // This would use GetObjectCommand with presigner
    return `https://${this.bucket}.s3.${process.env.AWS_REGION}.amazonaws.com/${key}`;
  }
}

// 7. Chunked upload for large files
class ChunkedUploadManager {
  constructor(options = {}) {
    this.chunkSize = options.chunkSize || 5 * 1024 * 1024; // 5MB chunks
    this.uploadDir = path.join(process.cwd(), '.ultra-dex', 'chunks');
    this.maxChunks = options.maxChunks || 1000; // Max 5GB files
  }

  async startUpload(fileId, totalSize, totalChunks) {
    if (totalChunks > this.maxChunks) {
      throw new Error('File too large for upload');
    }

    const uploadPath = path.join(this.uploadDir, fileId);
    await fs.mkdir(uploadPath, { recursive: true });

    return {
      uploadId: fileId,
      chunkSize: this.chunkSize,
      uploadPath
    };
  }

  async uploadChunk(uploadId, chunkIndex, chunkData) {
    const chunkPath = path.join(this.uploadDir, uploadId, `chunk_${chunkIndex}`);
    await fs.writeFile(chunkPath, chunkData);
    
    return { chunkIndex, uploaded: true };
  }

  async completeUpload(uploadId, totalChunks) {
    const uploadPath = path.join(this.uploadDir, uploadId);
    const outputPath = path.join(this.uploadDir, `${uploadId}.final`);

    const writeStream = createWriteStream(outputPath);

    for (let i = 0; i < totalChunks; i++) {
      const chunkPath = path.join(uploadPath, `chunk_${i}`);
      const readStream = createReadStream(chunkPath);
      await pipeline(readStream, writeStream);
    }

    // Verify file integrity
    const finalSize = (await fs.stat(outputPath)).size;
    
    // Cleanup chunks
    await fs.rm(uploadPath, { recursive: true });

    return {
      path: outputPath,
      size: finalSize,
      completed: true
    };
  }

  async abortUpload(uploadId) {
    const uploadPath = path.join(this.uploadDir, uploadId);
    await fs.rm(uploadPath, { recursive: true, force: true });
  }
}

// 8. Upload endpoint with all security measures
export async function handleFileUpload(req, res) {
  try {
    // Validate request
    if (!req.files || req.files.length === 0) {
      return res.status(400).json({ error: 'No files uploaded' });
    }

    const uploadedFiles = [];
    const cloudStorage = new CloudStorageManager();

    for (const file of req.files) {
      // Process file with security checks
      const fileInfo = await processUploadedFile(file.path);

      // Store in cloud storage if configured
      let cloudInfo = null;
      if (process.env.USE_CLOUD_STORAGE) {
        cloudInfo = await cloudStorage.uploadFile(file.path, {
          userId: req.user?.id
        });
      }

      // Add to database
      const dbRecord = await createFileRecord({
        originalName: file.originalname,
        storedPath: file.path,
        cloudKey: cloudInfo?.key,
        size: fileInfo.size,
        mimeType: fileInfo.mimeType,
        checksum: fileInfo.sha256,
        uploadedBy: req.user?.id || null,
        metadata: fileInfo.metadata
      });

      uploadedFiles.push({
        id: dbRecord.id,
        originalName: file.originalname,
        size: fileInfo.size,
        mimeType: fileInfo.mimeType,
        url: cloudInfo?.url || null,
        uploadedAt: fileInfo.uploadedAt
      });

      // Clean up temporary file
      await fs.unlink(file.path).catch(() => {}); // Don't fail if cleanup fails
    }

    res.status(201).json({
      success: true,
      files: uploadedFiles,
      message: `Successfully uploaded ${uploadedFiles.length} file(s)`
    });

  } catch (error) {
    console.error('File upload error:', error);
    
    // Clean up any partially uploaded files
    if (req.files) {
      for (const file of req.files) {
        await fs.unlink(file.path).catch(() => {});
      }
    }

    res.status(500).json({
      error: 'File upload failed',
      message: error.message
    });
  }
}

// 9. File download with security
export async function handleFileDownload(req, res) {
  const { fileId } = req.params;
  
  try {
    // Verify user has access to file
    const fileRecord = await getFileRecord(fileId);
    if (!fileRecord) {
      return res.status(404).json({ error: 'File not found' });
    }

    // Check permissions
    if (!await hasFileAccess(req.user, fileRecord)) {
      return res.status(403).json({ error: 'Access denied' });
    }

    // Serve file securely
    if (fileRecord.cloudKey && process.env.USE_CLOUD_STORAGE) {
      // Redirect to presigned URL for cloud storage
      const cloudStorage = new CloudStorageManager();
      const presignedUrl = await cloudStorage.generatePresignedUrl(fileRecord.cloudKey);
      return res.redirect(302, presignedUrl);
    } else {
      // Serve from local storage
      res.download(fileRecord.storedPath, fileRecord.originalName);
    }
  } catch (error) {
    console.error('File download error:', error);
    res.status(500).json({ error: 'File download failed' });
  }
}

// 10. File cleanup and maintenance
export async function cleanupOldFiles(days = 30) {
  const cutoffDate = new Date();
  cutoffDate.setDate(cutoffDate.getDate() - days);

  // Find files older than cutoff
  const oldFiles = await findFilesOlderThan(cutoffDate);

  for (const file of oldFiles) {
    try {
      // Delete from storage
      if (file.storedPath) {
        await fs.unlink(file.storedPath).catch(() => {});
      }
      
      // Delete from cloud if exists
      if (file.cloudKey) {
        const cloudStorage = new CloudStorageManager();
        await cloudStorage.deleteFile(file.cloudKey);
      }
      
      // Remove from database
      await deleteFileRecord(file.id);
      
      console.log(`Cleaned up old file: ${file.id}`);
    } catch (error) {
      console.error(`Failed to clean up file ${file.id}:`, error.message);
    }
  }
}
