// lib/voice/history.js
export class VoiceCommandHistory {
  constructor() {
    this.historyFile = path.join(process.cwd(), '.ultra-dex', 'voice-history.json');
    this.maxEntries = 100;
  }

  async loadHistory() {
    try {
      const content = await fs.readFile(this.historyFile, 'utf8');
      return JSON.parse(content);
    } catch {
      return [];
    }
  }

  async saveHistory(history) {
    // Keep only the most recent entries
    const trimmedHistory = history.slice(-this.maxEntries);
    
    await fs.mkdir(path.dirname(this.historyFile), { recursive: true });
    await fs.writeFile(this.historyFile, JSON.stringify(trimmedHistory, null, 2));
  }

  async addEntry(entry) {
    const history = await this.loadHistory();
    history.push({
      ...entry,
      timestamp: new Date().toISOString()
    });
    
    await this.saveHistory(history);
  }

  async getLearningInsights() {
    const history = await this.loadHistory();
    
    // Analyze patterns in voice commands
    const insights = {
      mostUsedCommands: this.getMostUsedCommands(history),
      commonPhrases: this.getCommonPhrases(history),
      accuracyTrends: this.getAccuracyTrends(history),
      improvementAreas: this.getImprovementAreas(history)
    };
    
    return insights;
  }

  getMostUsedCommands(history) {
    const commandCounts = {};
    history.forEach(entry => {
      if (entry.command) {
