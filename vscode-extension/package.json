{
  "name": "ultra-dex-vscode",
  "displayName": "Ultra-Dex: AI Agent Orchestration",
  "description": "Meta-orchestration layer for AI development. Coordinate Claude, GPT, Cursor, and Copilot with architectural memory, agent swarms, and code execution sandbox.",
  "version": "3.4.3",
  "publisher": "SrujanSaiKarna",
  "license": "MIT",
  "icon": "resources/icons/ultra-dex-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Srujan0798/Ultra-Dex"
  },
  "homepage": "https://github.com/Srujan0798/Ultra-Dex#readme",
  "bugs": {
    "url": "https://github.com/Srujan0798/Ultra-Dex/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "ai",
    "agents",
    "claude",
    "gpt",
    "cursor",
    "copilot",
    "orchestration",
    "swarm",
    "mcp",
    "model-context-protocol",
    "anthropic",
    "openai"
  ],
  "galleryBanner": {
    "color": "#6366f1",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/npm/v/ultra-dex.svg",
      "href": "https://www.npmjs.com/package/ultra-dex",
      "description": "npm version"
    }
  ],
  "activationEvents": [
    "workspaceContains:IMPLEMENTATION-PLAN.md",
    "workspaceContains:CONTEXT.md",
    "workspaceContains:.ultra-dex/**",
    "onView:ultra-dex.agentExplorer",
    "onView:ultra-dex.quickActions",
    "onView:ultra-dex.swarmStatus",
    "onView:ultra-dex.contextPreview"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ultra-dex",
          "title": "Ultra-Dex",
          "icon": "resources/icons/ultra-dex.svg"
        }
      ]
    },
    "views": {
      "ultra-dex": [
        {
          "id": "ultra-dex.agentExplorer",
          "name": "Agent Explorer"
        },
        {
          "id": "ultra-dex.swarmStatus",
          "name": "Swarm Status"
        },
        {
          "id": "ultra-dex.contextPreview",
          "name": "Context Preview"
        },
        {
          "id": "ultra-dex.quickActions",
          "name": "Quick Actions"
        }
      ]
    },
    "commands": [
      {
        "command": "ultra-dex.selectAgent",
        "title": "Select Agent",
        "category": "Ultra-Dex",
        "icon": "$(robot)"
      },
      {
        "command": "ultra-dex.checkAlignment",
        "title": "Check Alignment",
        "category": "Ultra-Dex",
        "icon": "$(check)"
      },
      {
        "command": "ultra-dex.generatePlan",
        "title": "Generate Plan",
        "category": "Ultra-Dex",
        "icon": "$(list-ordered)"
      },
      {
        "command": "ultra-dex.askAgent",
        "title": "Ask @Agent about selection",
        "category": "Ultra-Dex",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "ultra-dex.runSwarm",
        "title": "Run Agent Swarm",
        "category": "Ultra-Dex",
        "icon": "$(run-all)"
      },
      {
        "command": "ultra-dex.execCode",
        "title": "Execute in Sandbox",
        "category": "Ultra-Dex",
        "icon": "$(play)"
      },
      {
        "command": "ultra-dex.searchCode",
        "title": "Semantic Search",
        "category": "Ultra-Dex",
        "icon": "$(search)"
      },
      {
        "command": "ultra-dex.startKernel",
        "title": "Start Active Kernel",
        "category": "Ultra-Dex",
        "icon": "$(server-process)"
      },
      {
        "command": "ultra-dex.openDashboard",
        "title": "Open Dashboard",
        "category": "Ultra-Dex",
        "icon": "$(dashboard)"
      },
      {
        "command": "ultra-dex.syncGitHub",
        "title": "Sync GitHub Issues",
        "category": "Ultra-Dex",
        "icon": "$(github)"
      },
      {
        "command": "ultra-dex.refreshAgents",
        "title": "Refresh Agents",
        "category": "Ultra-Dex",
        "icon": "$(refresh)"
      },
      {
        "command": "ultra-dex.runSpecificAgent",
        "title": "Run Agent",
        "category": "Ultra-Dex",
        "icon": "$(play)"
      },
      {
        "command": "ultra-dex.stopAgent",
        "title": "Stop Agent",
        "category": "Ultra-Dex",
        "icon": "$(stop-circle)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ultra-dex.askAgent",
          "when": "editorHasSelection",
          "group": "Ultra-Dex@1"
        },
        {
          "command": "ultra-dex.execCode",
          "when": "editorHasSelection && resourceExtname =~ /\\.(js|ts|py|go|rs)$/",
          "group": "Ultra-Dex@2"
        }
      ],
      "view/title": [
        {
          "command": "ultra-dex.refreshAgents",
          "when": "view == ultra-dex.agentExplorer",
          "group": "navigation"
        },
        {
          "command": "ultra-dex.runSwarm",
          "when": "view == ultra-dex.swarmStatus",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ultra-dex.runSpecificAgent",
          "when": "view == ultra-dex.agentExplorer && viewItem == agent",
          "group": "Ultra-Dex@1"
        },
        {
          "command": "ultra-dex.stopAgent",
          "when": "view == ultra-dex.agentExplorer && viewItem == agent",
          "group": "Ultra-Dex@2"
        }
      ]
    },
    "configuration": {
      "title": "Ultra-Dex",
      "properties": {
        "ultra-dex.defaultProvider": {
          "type": "string",
          "default": "anthropic",
          "enum": ["anthropic", "openai", "google"],
          "description": "Default AI provider for agents"
        },
        "ultra-dex.kernelPort": {
          "type": "number",
          "default": 3001,
          "description": "Port for the Active Kernel server"
        },
        "ultra-dex.dashboardPort": {
          "type": "number",
          "default": 3002,
          "description": "Port for the God Mode dashboard"
        },
        "ultra-dex.autoStartKernel": {
          "type": "boolean",
          "default": false,
          "description": "Automatically start the kernel when opening a project"
        },
        "ultra-dex.enableSandbox": {
          "type": "boolean",
          "default": true,
          "description": "Enable Docker sandbox for code execution"
        }
      }
    },
    "keybindings": [
      {
        "command": "ultra-dex.selectAgent",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "ultra-dex.searchCode",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s"
      },
      {
        "command": "ultra-dex.runSwarm",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.5.4"
  }
}