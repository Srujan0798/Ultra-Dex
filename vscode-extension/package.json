{
  "name": "ultra-dex-vscode",
  "displayName": "Ultra-Dex",
  "description": "Ultra-Dex companion extension",
  "version": "0.1.0",
  "publisher": "ultra-dex",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Productivity"],
  "activationEvents": [
    "onCommand:ultra-dex.openContext",
    "onCommand:ultra-dex.generate",
    "onView:ultraDexSidebar"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "ultra-dex.openContext", "title": "Ultra-Dex: Open CONTEXT.md" },
      { "command": "ultra-dex.generate", "title": "Ultra-Dex: Generate Plan" }
    ],
    "views": {
      "explorer": [
        {
          "id": "ultraDexSidebar",
          "name": "Ultra-Dex Agents"
        }
      ]
    }
  },
  "scripts": {
    "compile": "npm run build",
    "build": "tsc -p .",
    "watch": "tsc -watch -p ."
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
