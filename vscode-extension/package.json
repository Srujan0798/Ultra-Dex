{
  "name": "ultra-dex-vscode",
  "displayName": "Ultra-Dex",
  "description": "Ultra-Dex AI agent explorer, alignment tools, and project orchestration for VS Code.",
  "version": "1.0.0",
  "publisher": "ultra-dex",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Snippets"
  ],
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "copilot",
    "cursor"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ultra-dex",
          "title": "Ultra-Dex",
          "icon": "resources/icons/ultra-dex.svg"
        }
      ]
    },
    "views": {
      "ultra-dex": [
        {
          "id": "ultra-dex.contextView",
          "name": "Project Context"
        },
        {
          "id": "ultra-dex.agentExplorer",
          "name": "Agents (16)"
        },
        {
          "id": "ultra-dex.quickActions",
          "name": "Quick Actions"
        },
        {
          "id": "ultra-dex.verifyView",
          "name": "Verification Checklist"
        }
      ]
    },
    "commands": [
      {
        "command": "ultra-dex.generatePlan",
        "title": "Generate Plan",
        "category": "Ultra-Dex",
        "icon": "$(list-ordered)"
      },
      {
        "command": "ultra-dex.startBuildMode",
        "title": "Start Build Mode",
        "category": "Ultra-Dex",
        "icon": "$(tools)"
      },
      {
        "command": "ultra-dex.runAgent",
        "title": "Run Agent",
        "category": "Ultra-Dex",
        "icon": "$(run)"
      },
      {
        "command": "ultra-dex.openDashboard",
        "title": "Open Dashboard",
        "category": "Ultra-Dex",
        "icon": "$(dashboard)"
      },
      {
        "command": "ultra-dex.showAlignmentScore",
        "title": "Show Alignment Score",
        "category": "Ultra-Dex",
        "icon": "$(shield)"
      },
      {
        "command": "ultra-dex.startDaemon",
        "title": "Start God Mode Daemon",
        "category": "Ultra-Dex",
        "icon": "$(zap)"
      },
      {
        "command": "ultra-dex.autoImplement",
        "title": "Auto-Implement Feature",
        "category": "Ultra-Dex",
        "icon": "$(sparkle)"
      },
      {
        "command": "ultra-dex.syncProject",
        "title": "Sync Project State",
        "category": "Ultra-Dex",
        "icon": "$(sync)"
      },
      {
        "command": "ultra-dex.selectAgent",
        "title": "Select Agent",
        "category": "Ultra-Dex"
      },
      {
        "command": "ultra-dex.copyAgentPrompt",
        "title": "Copy Agent Prompt",
        "category": "Ultra-Dex",
        "icon": "$(copy)"
      },
      {
        "command": "ultra-dex.askAgent",
        "title": "Ask Agent",
        "category": "Ultra-Dex"
      },
      {
        "command": "ultra-dex.verify",
        "title": "Run Verification",
        "category": "Ultra-Dex",
        "icon": "$(checklist)"
      },
      {
        "command": "ultra-dex.refreshAgents",
        "title": "Refresh Agents",
        "category": "Ultra-Dex",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ultra-dex.refreshAgents",
          "when": "view == ultra-dex.agentExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ultra-dex.copyAgentPrompt",
          "when": "view == ultra-dex.agentExplorer && viewItem == agent",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "ultra-dex.askAgent",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  }
}