{
  "name": "ultra-dex-vscode",
  "displayName": "Ultra-Dex AI Development Platform",
  "description": "AI-powered development tools with persistent memory and governance",
  "version": "1.0.0",
  "publisher": "UltraDex",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:ultra-dex.openDashboard",
    "onCommand:ultra-dex.runAgent",
    "onCommand:ultra-dex.syncContext",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ultra-dex.openDashboard",
        "title": "Open Ultra-Dex Dashboard"
      },
      {
        "command": "ultra-dex.runAgent",
        "title": "Run Ultra-Dex Agent"
      },
      {
        "command": "ultra-dex.syncContext",
        "title": "Sync Context with Ultra-Dex"
      },
      {
        "command": "ultra-dex.voiceCommand",
        "title": "Voice Command to Code"
      },
      {
        "command": "ultra-dex.analyzeFile",
        "title": "Analyze File with AI"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "ultra-dex-agents",
          "name": "AI Agents",
          "when": "workspaceFolder"
        },
        {
          "id": "ultra-dex-context",
          "name": "Project Context",
          "when": "workspaceFolder"
        }
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "ultra-dex.analyzeFile",
          "when": "resourceExtname == '.js' || resourceExtname == '.ts' || resourceExtname == '.jsx' || resourceExtname == '.tsx'",
          "group": "ai-tools@1"
        }
      ]
    },
    "configuration": {
      "title": "Ultra-Dex",
      "properties": {
        "ultra-dex.apiKey": {
          "type": "string",
          "description": "Your Ultra-Dex API key",
          "default": ""
        },
        "ultra-dex.model": {
          "type": "string",
          "description": "AI model to use",
          "default": "gpt-4",
          "enum": ["gpt-4", "gpt-3.5-turbo", "claude-3-opus", "claude-3-sonnet"]
        },
        "ultra-dex.enableContextSync": {
          "type": "boolean",
          "description": "Enable automatic context synchronization",
          "default": true
        },
        "ultra-dex.mcpPort": {
          "type": "number",
          "description": "MCP server port",
          "default": 3002
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}