{
  "name": "ultra-dex-vscode",
  "displayName": "Ultra-Dex",
  "description": "Ultra-Dex AI agent explorer, alignment tools, and project orchestration for VS Code.",
  "version": "1.0.0",
  "publisher": "ultra-dex",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Snippets"
  ],
  "keywords": [
    "ai",
    "agents",
    "orchestration",
    "copilot",
    "cursor"
  ],
  "activationEvents": [
    "onView:ultra-dex.agentExplorer",
    "onCommand:ultra-dex.selectAgent",
    "onCommand:ultra-dex.checkAlignment",
    "onCommand:ultra-dex.triggerSwarm",
    "onCommand:ultra-dex.openDashboard",
    "onCommand:ultra-dex.askAgent"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ultra-dex",
          "title": "Ultra-Dex",
          "icon": "resources/icons/ultra-dex.svg"
        }
      ]
    },
    "views": {
      "ultra-dex": [
        {
          "id": "ultra-dex.projectRoadmap",
          "name": "Project Roadmap",
          "icon": "$(map)"
        },
        {
          "id": "ultra-dex.agentExplorer",
          "name": "Agent Explorer"
        }
      ]
    },
    "commands": [
      {
        "command": "ultra-dex.selectAgent",
        "title": "Ultra-Dex: Select Agent",
        "category": "Ultra-Dex"
      },
      {
        "command": "ultra-dex.checkAlignment",
        "title": "Ultra-Dex: Check Alignment",
        "category": "Ultra-Dex"
      },
      {
        "command": "ultra-dex.triggerSwarm",
        "title": "Ultra-Dex: Trigger Swarm",
        "category": "Ultra-Dex",
        "icon": "$(zap)"
      },
      {
        "command": "ultra-dex.openDashboard",
        "title": "Ultra-Dex: Open Dashboard",
        "category": "Ultra-Dex",
        "icon": "$(dashboard)"
      },
      {
        "command": "ultra-dex.askAgent",
        "title": "Ultra-Dex: Ask @Agent about selection",
        "category": "Ultra-Dex"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ultra-dex.triggerSwarm",
          "when": "editorHasSelection",
          "group": "navigation@1"
        },
        {
          "command": "ultra-dex.askAgent",
          "when": "editorHasSelection",
          "group": "navigation@2"
        }
      ],
      "view/title": [
        {
          "command": "ultra-dex.openDashboard",
          "when": "view == ultra-dex.agentExplorer",
          "group": "navigation"
        },
        {
          "command": "ultra-dex.checkAlignment",
          "when": "view == ultra-dex.agentExplorer",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.5.4"
  }
}
