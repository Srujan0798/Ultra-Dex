  "homepage": "https://github.com/Srujan0798/Ultra-Dex",
  "bugs": {
    "url": "https://github.com/Srujan0798/Ultra-Dex/issues"
  },
  "bin": {
    "ultra-dex": "./cli/bin/ultra-dex.js"
  },
  "files": [
    "cli/bin",
    "cli/lib",
    "cli/assets",
    "cli/templates",
    "cli/test",
    "PRODUCTION_DEPLOYMENT.md",
    "GETTING_STARTED.md",
    "ADVANCED_USAGE.md",
    "BEST_PRACTICES.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "scripts": {
    "start": "node cli/bin/ultra-dex.js",
    "dev": "node --watch cli/bin/ultra-dex.js",
    "test": "NODE_ENV=test node --test $(find cli/test -name \"*.test.js\" -print)",
    "test:unit": "NODE_ENV=test node --test $(find cli/test/unit -name \"*.test.js\" -print)",
    "test:integration": "NODE_ENV=test node --test $(find cli/test/integration -name \"*.test.js\" -print)",
    "test:watch": "NODE_ENV=test node --test --watch $(find cli/test -name \"*.test.js\" -print)",
    "test:coverage": "NODE_ENV=test c8 node --test $(find cli/test -name \"*.test.js\" -print)",
    "test:ui": "NODE_ENV=test node --test --watch $(find cli/test -name \"*.test.js\" -print)",
    "lint": "eslint cli/lib --ext .js,.ts",
    "lint:fix": "eslint cli/lib --ext .js,.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "echo 'No build step required'",
    "build:docs": "cd docs-site && npm run build",
    "build:desktop": "cd apps/desktop && npm run build",
    "build:vscode": "cd extensions/vscode && npm run build",
    "publish": "npm publish",
    "publish:beta": "npm publish --tag beta",
    "version:bump": "npm version",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "prepare": "husky install",
    "pre-commit": "lint-staged",
    "governance": "node scripts/pre-commit-governor.js",
    "security:audit": "npm audit --audit-level high",
    "security:fix": "npm audit fix",
    "perf:benchmark": "node scripts/benchmark.js",
    "perf:profile": "node --prof scripts/profile.js",
    "docker:build": "docker build -t ultra-dex .",
    "docker:run": "docker run -it ultra-dex",
    "docker:publish": "docker push ultra-dex",
    "kubernetes:deploy": "kubectl apply -f k8s/deployment.yaml",
    "release:alpha": "npm version prerelease --preid alpha && npm publish --tag alpha",
    "release:beta": "npm version prerelease --preid beta && npm publish --tag beta",
    "release:rc": "npm version prerelease --preid rc && npm publish --tag next",
    "release:stable": "npm version minor && npm publish",
    "docs:serve": "cd docs-site && npm run start",
    "dashboard:dev": "cd dashboard && npm run dev",
    "dashboard:build": "cd dashboard && npm run build",
    "dashboard:preview": "cd dashboard && npm run preview",
    "cli:dev": "nodemon --watch cli/bin --watch cli/lib cli/bin/ultra-dex.js",
    "cli:profile": "clinic doctor -- node cli/bin/ultra-dex.js",
    "cli:flame": "clinic flame -- node cli/bin/ultra-dex.js",
    "cli:heapprofile": "clinic bubbleprof -- node cli/bin/ultra-dex.js"
  },
