{
  "name": "@ultra-dex/cli",
  "version": "2.0.0-alpha.0",
  "private": true,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "AI orchestration meta-layer — route tasks across 13+ providers, coordinate multi-agent swarms, persistent memory",
  "keywords": [
    "ai",
    "orchestration",
    "saas",
    "mcp",
    "langchain",
    "claude",
    "openai",
    "gemini",
    "agents",
    "swarm",
    "docker",
    "sandbox",
    "github",
    "browser-automation",
    "agent-sdk",
    "plugin-architecture",
    "extensible",
    "performance-optimized",
    "security-hardened"
  ],
  "author": "Srujan Sai Karna",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Srujan0798/Ultra-Dex"
  },
  "homepage": "https://ultradex.vercel.app",
  "bugs": {
    "url": "https://github.com/Srujan0798/Ultra-Dex/issues"
  },
  "bin": {
    "ultra-dex": "./dist/ultra-dex.mjs"
  },
  "main": "./dist/ultra-dex.mjs",
  "files": [
    "apps/cli/bin",
    "apps/cli/lib",
    "apps/cli/assets",
    "apps/cli/templates",
    "src/core",
    "src/services/ai-providers",
    "packages/sdk",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/ARCHITECTURE.md",
    "docs/CHANGELOG.md"
  ],
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/cli",
    "apps/cloud",
    "apps/dashboard",
    "apps/desktop",
    "apps/white-label",
    "packages/agent-protocol",
    "packages/analytics",
    "packages/cloud-integrations",
    "packages/compliance",
    "packages/core",
    "packages/cursor-rules",
    "packages/dexgraph",
    "packages/extensions",
    "packages/mcp-server",
    "packages/marketplace",
    "packages/mobile-sdk",
    "packages/plugins",
    "packages/sdk",
    "packages/vscode-extension"
  ],
  "scripts": {
    "prepare": "npm run build:cli",
    "start": "node dist/ultra-dex.mjs",
    "ultra-dex": "node dist/ultra-dex.mjs",
    "dev": "node --watch dist/ultra-dex.js",
    "nemotron": "node examples/nemotron-cli.js",
    "nemotron:example": "node examples/nemotron-example.js",
    "nemotron:models": "node examples/multi-model-example.js",
    "test": "MEMORY_BACKEND=file SKIP_POSTGRES=true NODE_ENV=test node --import=tsx --import=reflect-metadata --test --test-concurrency=1 --test-force-exit --test-timeout=30000 tests/core/*.test.{js,ts} tests/integration/*.test.{js,ts} tests/cli/*.test.{js,ts}",
    "test:unit": "MEMORY_BACKEND=file SKIP_POSTGRES=true NODE_ENV=test node --import=tsx --import=reflect-metadata --test --test-concurrency=1 --test-force-exit --test-timeout=30000 tests/core/*.test.{js,ts}",
    "test:integration": "NODE_ENV=test node --import=tsx --import=reflect-metadata --test --test-force-exit --test-timeout=60000 tests/integration/*.test.{js,ts}",
    "test:cli": "NODE_ENV=test node --import=tsx --import=reflect-metadata --test --test-force-exit --test-timeout=30000 tests/cli/*.test.{js,ts}",
    "ultra:start": "node scripts/ultra-orchestrator.js start",
    "ultra:status": "node scripts/ultra-orchestrator.js status",
    "ultra:pause": "node scripts/ultra-orchestrator.js pause",
    "ultra:resume": "node scripts/ultra-orchestrator.js resume",
    "ultra:stop": "node scripts/ultra-orchestrator.js stop",
    "ultra:report": "node scripts/ultra-orchestrator.js report",
    "test:push:smoke": "NODE_ENV=test node --import=tsx --import=reflect-metadata --test --test-force-exit --test-timeout=30000 tests/core/provider-fallback.test.js tests/core/approval-workflow.test.js tests/core/git-integration.test.js tests/cli/plan.test.js tests/cli/serve.test.js tests/cli/swarm.test.js apps/cli/test/git-workflow.test.js",
    "test:performance": "NODE_ENV=test node --import=tsx --import=reflect-metadata --test --test-timeout=60000 tests/performance/*.test.js",
    "test:perf": "NODE_ENV=test node --import=tsx --import=reflect-metadata --test --test-force-exit --test-timeout=60000 tests/perf/*.bench.ts",
    "test:all": "NODE_ENV=test node --import=tsx --import=reflect-metadata --test --test-timeout=60000 tests/**/*.test.js",
    "test:watch": "NODE_ENV=test node --import=tsx --import=reflect-metadata --test --watch --test-timeout=30000 tests/core/*.test.js",
    "test:e2e": "node --test tests/e2e/*.test.js",
    "test:coverage": "NODE_ENV=test npx c8 --reporter=text --reporter=lcov node --import=tsx --import=reflect-metadata --test tests/core/*.test.js tests/integration/*.test.js tests/cli/*.test.js",
    "test:ci": "NODE_ENV=test node --import=tsx --import=reflect-metadata --test --test-reporter=spec tests/core/*.test.js tests/integration/*.test.js tests/cli/*.test.js",
    "coverage:report": "npx c8 report --reporter=html",
    "lint": "node scripts/run-lint.js",
    "lint:fix": "eslint apps/cli/lib --ext .js,.ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "cd packages/dexgraph && npx tsc --noEmit && cd ../sdk && npx tsc --noEmit",
    "build": "npm run build:core && npm run build:cli && npm run build:dashboard",
    "build:core": "sh scripts/build-core.sh",
    "build:dashboard": "npm run dashboard:build",
    "build:cli": "sh scripts/build-cli.sh",
    "build:desktop": "cd apps/desktop && npm run build",
    "build:vscode": "cd packages/extensions/vscode && npm run build",
    "publish": "npm publish",
    "publish:beta": "npm publish --tag beta",
    "publish:cli": "cd apps/cli && npm publish --access public",
    "publish:sdk": "cd packages/sdk && npm publish --access public",
    "version:bump": "npm version",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "governance": "node scripts/pre-commit-governor.js",
    "security:precommit": "sh .husky/pre-commit",
    "compliance:check": "node gitFail/compliance/check-governance-files.js",
    "guard:github": "node gitFail/compliance/github-guard.js",
    "guard:github:local": "SKIP_REMOTE_CHECK=1 node gitFail/compliance/github-guard.js",
    "gate:local": "sh gitFail/compliance/run-enterprise-gate.sh local",
    "gate:push": "sh gitFail/compliance/run-enterprise-gate.sh push",
    "gate:push:full": "ENTERPRISE_GATE_FULL=1 sh gitFail/compliance/run-enterprise-gate.sh push",
    "safety:daily": "sh gitFail/compliance/daily-safety-check.sh",
    "security:audit": "npm audit --audit-level high",
    "security:fix": "npm audit fix",
    "perf:benchmark": "node scripts/benchmark.js",
    "perf:profile": "node --prof scripts/profile.js",
    "docker:build": "docker build -t ultra-dex .",
    "docker:run": "docker run -it ultra-dex",
    "docker:publish": "docker push ultra-dex",
    "kubernetes:deploy": "kubectl apply -f config/k8s-deployment.yaml",
    "release:alpha": "npm version prerelease --preid alpha && npm publish --tag alpha",
    "release:beta": "npm version prerelease --preid beta && npm publish --tag beta",
    "release:rc": "npm version prerelease --preid rc && npm publish --tag next",
    "release:stable": "npm version minor && npm publish",
    "docs:serve": "cd apps/docs-site && npm run docs:dev",
    "dashboard:dev": "cd apps/dashboard && npm run dev",
    "dashboard:build": "cd apps/dashboard && npm run build",
    "dashboard:a11y": "cd apps/dashboard && npm run test:a11y",
    "dashboard:preview": "cd apps/dashboard && npm run preview",
    "cli:dev": "node --watch apps/cli/bin/ultra-dex.js",
    "demo": "MOCK_AI=true node examples/nexus-demo.js",
    "auto-ceo": "npx tsx src/automation/index.ts start",
    "auto-ceo:status": "npx tsx src/automation/index.ts status",
    "auto-ceo:once": "npx tsx src/automation/index.ts run-once",
    "auto-ceo:decision": "npx tsx src/automation/decision-engine.ts",
    "test:automation": "NODE_ENV=test node --import=tsx --test tests/automation/*.test.ts",
    "incidents:verify": "node gitFail/incidents/verify-incident-archive.js",
    "start:prod": "./scripts/start-production.sh",
    "start:api": "node --import=tsx src/core/server/api-server.ts",
    "start:server": "node --import=tsx src/core/server/production-server.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "3.0.71",
    "@ai-sdk/google": "3.0.60",
