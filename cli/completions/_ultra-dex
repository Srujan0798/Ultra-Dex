#compdef ultra-dex
# Ultra-Dex CLI Zsh Completion

_ultra_dex() {
    local curcontext="$curcontext" state line
    typeset -A opt_args
    
    _arguments -C \
        '(-h --help)'{-h,--help}'[Show help]' \
        '(-v --version)'{-v,--version}'[Show version]' \
        '(--verbose)'--verbose'[Verbose output]' \
        '(--debug)'--debug'[Debug mode]' \
        '(--json)'--json'[JSON output]' \
        '1: :_ultra_dex_commands' \
        '*:: :->args'
    
    case "$state" in
        args)
            case "$line[1]" in
                init)
                    _arguments \
                        '(--template)'--template'[Template type]:template:(lite full enterprise)' \
                        '(--force)'--force'[Force overwrite]' \
                        '(--skip-git)'--skip-git'[Skip git init]'
                    ;;
                run)
                    _arguments \
                        '1:agent:_ultra_dex_agents'
                    ;;
                swarm)
                    _arguments \
                        '(--dry-run)'--dry-run'[Dry run only]' \
                        '(--agents)'--agents'[Specific agents]:agents:' \
                        '(--timeout)'--timeout'[Timeout in ms]:timeout:'
                    ;;
                agents)
                    _arguments \
                        '1:action:(list install create publish)' \
                        '(--marketplace)'--marketplace'[Browse marketplace]'
                    ;;
                sync)
                    _arguments \
                        '(--brain)'--brain'[Sync with brain]' \
                        '(--watch)'--watch'[Watch mode]' \
                        '(--force)'--force'[Force sync]'
                    ;;
                memory)
                    _arguments \
                        '1:action:(list add search clear sessions decisions query stats)'
                    ;;
                estimate)
                    _arguments \
                        '1:task type:(simple-task feature-impl plan-generation complex-refactor agent-swarm context-sync)' \
                        '(--tokens)'--tokens'[Token count]:tokens:' \
                        '(--provider)'--provider'[AI provider]:provider:(openai anthropic google local)' \
                        '(--monthly)'--monthly'[Monthly estimate]:count:' \
                        '(--json)'--json'[JSON output]'
                    ;;
                voice)
                    _arguments \
                        '(--provider)'--provider'[STT provider]:provider:(whisper google azure)' \
                        '(--language)'--language'[Language code]:lang:' \
                        '(--output)'--output'[Output file]:file:_files' \
                        '(--template)'--template'[Template]:template:(lite full enterprise)' \
                        '(--save-audio)'--save-audio'[Save audio file]'
                    ;;
            esac
            ;;
    esac
}

