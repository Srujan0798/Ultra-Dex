# Ultra-Dex .dockerignore

# Dependencies (installed in container)
node_modules
**/node_modules

# Build artifacts
dist
**/dist
.next
**/.next
.docusaurus
**/.docusaurus
*.vsix
**/out
**/*.tsbuildinfo

# Environment files
.env
.env.*
!.env.example

# Runtime data
.ultra
.ultra-dex
**/.ultra
**/.ultra-dex
data/memory.db
data/autopsy
data/observability

# Logs
*.log
**/*.log
logs
**/logs

# Git
.git
.gitignore
.gitattributes

# IDE and editors
.vscode
.idea
*.swp
*.swo
*~
.cursor

# OS files
.DS_Store
Thumbs.db

# Tests (not needed in production)
tests
**/tests
*.test.js
*.spec.js
*.test.ts
*.spec.ts
coverage
.nyc_output

# Documentation (not needed in production)
docs
**/docs
*.md
!README.md

# Development tools
.husky
.kilo
upgrade

# Backup files
*-bak
**/*-bak
*.bak
**/*.bak

# Duplicate directories
* 2
**/* 2
* 2.*
**/* 2.*

# Temporary files
tmp
temp
.cache
**/.cache

# Reports and archives
*-report.json
archive
**/archive
reports
**/reports
benchmarks
**/benchmarks
benchmark-results
**/benchmark-results
!src/benchmarks
!src/benchmarks/performance-metrics.js

# Business and marketing (not needed in production)
business
marketing
community

# Examples
examples
**/examples

# Docker files
docker-compose.override.yml
Dockerfile*
.dockerignore

# Jupyter sessions
jules-sessions-*

# Package lock variants
package-lock*.json
!package-lock.json
