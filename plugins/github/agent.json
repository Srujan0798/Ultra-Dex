{
  "name": "@ultra-dex/github",
  "version": "1.0.0",
  "description": "GitHub-aware agent for PR management, code review, and issue tracking",
  "author": "ultra-dex",
  "agents": [
    {
      "role": "github-specialist",
      "model": "gpt-4o",
      "systemPrompt": "prompt.md",
      "capabilities": ["pr-creation", "code-review", "issue-management"],
      "costTier": "standard"
    }
  ],
  "tools": [
    {
      "name": "create_pr",
      "description": "Create a new pull request on GitHub",
      "schema": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "body": { "type": "string" },
          "head": { "type": "string" },
          "base": { "type": "string" }
        },
        "required": ["title", "head", "base"]
      },
      "handler": "tools/create-pr.ts"
    },
    {
      "name": "review_pr",
      "description": "Review a pull request and provide feedback",
      "schema": {
        "type": "object",
        "properties": {
          "pull_number": { "type": "integer" },
          "event": { "type": "string", "enum": ["APPROVE", "REQUEST_CHANGES", "COMMENT"] },
          "body": { "type": "string" }
        },
        "required": ["pull_number", "event"]
      },
      "handler": "tools/review-pr.ts"
    },
    {
      "name": "manage_issue",
      "description": "Create, update, or close GitHub issues",
      "schema": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["create", "update", "close"] },
          "issue_number": { "type": "integer" },
          "title": { "type": "string" },
          "body": { "type": "string" }
        },
        "required": ["action"]
      },
      "handler": "tools/manage-issues.ts"
    }
  ],
  "hooks": {},
  "dependencies": [],
  "minUltraDexVersion": "4.0.0"
}
