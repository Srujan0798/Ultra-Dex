# Environment Configuration Template
# Copy this file to .env and update the values for your environment

# ===========================================
# General Configuration
# ===========================================
NODE_ENV=development

# ===========================================
# JWT Configuration
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ===========================================
# Database Configuration
# ===========================================
# Auth Service Database
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_pass123

# Users Service Database
USERS_DB_HOST=localhost
USERS_DB_PORT=5433
USERS_DB_NAME=users_db
USERS_DB_USER=users_user
USERS_DB_PASSWORD=users_pass123

# Orders Service Database
ORDERS_DB_HOST=localhost
ORDERS_DB_PORT=5434
ORDERS_DB_NAME=orders_db
ORDERS_DB_USER=orders_user
ORDERS_DB_PASSWORD=orders_pass123

# Payments Service Database
PAYMENTS_DB_HOST=localhost
PAYMENTS_DB_PORT=5435
PAYMENTS_DB_NAME=payments_db
PAYMENTS_DB_USER=payments_user
PAYMENTS_DB_PASSWORD=payments_pass123

# Notifications Service Database
NOTIFICATIONS_DB_HOST=localhost
NOTIFICATIONS_DB_PORT=5436
NOTIFICATIONS_DB_NAME=notifications_db
NOTIFICATIONS_DB_USER=notifications_user
NOTIFICATIONS_DB_PASSWORD=notifications_pass123

# ===========================================
# Redis Configuration
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ===========================================
# RabbitMQ Configuration
# ===========================================
RABBITMQ_URL=amqp://admin:admin123@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_MANAGEMENT_PORT=15672

# ===========================================
# Service Discovery (Consul)
# ===========================================
CONSUL_HOST=localhost
CONSUL_PORT=8500

# ===========================================
# Distributed Tracing (Jaeger)
# ===========================================
JAEGER_ENDPOINT=http://localhost:4318/v1/traces
JAEGER_UI_PORT=16686

# ===========================================
# API Gateway Configuration
# ===========================================
API_GATEWAY_PORT=3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Service Ports (Development)
# ===========================================
AUTH_SERVICE_PORT=3001
USERS_SERVICE_PORT=3002
ORDERS_SERVICE_PORT=3003
PAYMENTS_SERVICE_PORT=3004
NOTIFICATIONS_SERVICE_PORT=3005

# ===========================================
# Service URLs (for inter-service communication)
# ===========================================
AUTH_SERVICE_URL=http://localhost:3001
USERS_SERVICE_URL=http://localhost:3002
ORDERS_SERVICE_URL=http://localhost:3003
PAYMENTS_SERVICE_URL=http://localhost:3004
NOTIFICATIONS_SERVICE_URL=http://localhost:3005

# ===========================================
# Security
# ===========================================
BCRYPT_ROUNDS=12

# ===========================================
# Caching
# ===========================================
CACHE_TTL=3600

# ===========================================
# Payment Gateway (Mock)
# ===========================================
PAYMENT_GATEWAY_MODE=mock

# ===========================================
# Email Configuration (Mock)
# ===========================================
SMTP_HOST=smtp.mock.com
SMTP_PORT=587
SMTP_USER=mock@example.com
SMTP_PASS=mockpass

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=debug
LOG_FORMAT=json
