{
  "name": "microservices-example",
  "version": "1.0.0",
  "description": "Complete microservices architecture template with Node.js, Express, PostgreSQL, Redis, and Docker",
  "private": true,
  "workspaces": [
    "services/*",
    "shared/*"
  ],
  "scripts": {
    "dev": "docker-compose up",
    "dev:build": "docker-compose up --build",
    "dev:detach": "docker-compose up -d",
    "stop": "docker-compose down",
    "logs": "docker-compose logs -f",
    "clean": "docker-compose down -v",
    "test": "npm run test --workspaces",
    "lint": "eslint . --ext .js,.ts",
    "format": "prettier --write ."
  },
  "keywords": [
    "microservices",
    "nodejs",
    "express",
    "postgresql",
    "redis",
    "rabbitmq",
    "docker",
    "api-gateway",
    "distributed-systems"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  }
}
