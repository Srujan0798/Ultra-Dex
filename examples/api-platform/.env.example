# API Platform Environment Configuration

# Node Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/api_platform?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Security
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
WEBHOOK_SECRET="your-webhook-signing-secret-change-this-in-production"
API_KEY_PREFIX="pk_live_"

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_FREE_REQUESTS=100
RATE_LIMIT_PRO_REQUESTS=1000
RATE_LIMIT_ENTERPRISE_REQUESTS=10000

# Webhook Settings
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAY_MS=1000
WEBHOOK_TIMEOUT_MS=30000

# Features
ENABLE_SWAGGER=true
ENABLE_METRICS=true

# CORS
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"

# Developer Portal
DEVELOPER_PORTAL_URL="http://localhost:3001"
