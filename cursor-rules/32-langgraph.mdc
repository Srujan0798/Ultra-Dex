# LangGraph Integration Patterns
## Ultra-Dex Cursor Rule 32-langgraph.mdc

### Context
LangGraph provides stateful, multi-step AI workflows with persistent memory. Critical for complex agent orchestrations that require memory across multiple interactions and decision points.

### Pattern
```javascript
// 1. LangGraph State Definition
// lib/agents/state.ts
import { BaseState } from "@langchain/core/states";
import { BaseMessage } from "@langchain/core/messages";

export interface AgentState extends BaseState {
  // Core state
  messages: BaseMessage[];
  current_step: string;
  completed_steps: string[];
  pending_tasks: string[];
  
  // Project context
  project_context: {
    name: string;
    description: string;
    tech_stack: string[];
    current_phase: string;
  };
  
  // Implementation plan
  implementation_plan: {
    sections: Array<{
      id: string;
      title: string;
      status: 'pending' | 'in_progress' | 'completed' | 'blocked';
      assigned_agent: string | null;
      dependencies: string[];
      estimated_hours: number;
      actual_hours: number;
    }>;
  };
  
  // Code graph context
  code_graph: {
    nodes: Array<{ id: string; type: string; path: string }>;
    edges: Array<{ from: string; to: string; type: string }>;
    dependencies: Record<string, string[]>;
  };
  
  // Agent coordination
  agent_assignments: Record<string, string>; // task_id -> agent_name
  agent_results: Record<string, any>;
  
  // Quality metrics
  quality_metrics: {
    alignment_score: number;
    code_quality: number;
    security_score: number;
    performance_score: number;
  };
  
  // Error recovery
  error_history: Array<{
    timestamp: string;
    error: string;
    context: string;
    recovery_attempted: boolean;
  }>;
  
  // Metadata
  created_at: string;
  updated_at: string;
  version: string;
}

// 2. Agent Nodes Implementation
// lib/agents/nodes.ts
import { BaseMessage, HumanMessage, AIMessage } from "@langchain/core/messages";
import { RunnableConfig } from "@langchain/core/runnables";
import { z } from "zod";
import { AgentExecutor } from "langchain/agents";

// Planner Node - Breaks down features into tasks
export async function plannerNode(state: AgentState, config?: RunnableConfig) {
  const { messages, project_context } = state;
  const lastMessage = messages[messages.length - 1];
  
  // Use the last user message as the feature request
  const featureRequest = lastMessage.content as string;
  
  // Generate task breakdown using AI
  const taskBreakdown = await generateTaskBreakdown(featureRequest, project_context);
  
  // Update state with new tasks
  const newSections = state.implementation_plan.sections.map(section => {
    if (taskBreakdown[section.id]) {
      return {
        ...section,
        status: 'pending',
        assigned_agent: taskBreakdown[section.id].agent
      };
    }
    return section;
  });
  
  return {
    messages: [
      ...messages,
      new AIMessage({
        content: `Task breakdown completed. ${taskBreakdown.length} tasks identified.`,
        additional_kwargs: { breakdown: taskBreakdown }
      })
    ],
    implementation_plan: {
      ...state.implementation_plan,
      sections: newSections
    },
    current_step: 'planning_complete',
    pending_tasks: taskBreakdown.map(t => t.id)
  };
}

// CTO Node - Makes architectural decisions
export async function ctoNode(state: AgentState, config?: RunnableConfig) {
  const { implementation_plan, project_context } = state;
  
  // Get pending tasks that need architectural review
  const pendingTasks = implementation_plan.sections.filter(
    section => section.status === 'pending' && section.assigned_agent === 'cto'
  );
  
  if (pendingTasks.length === 0) {
    return state; // No tasks for CTO
  }
  
  // Generate architectural decisions
  const architectureDecisions = await generateArchitectureDecisions(
    pendingTasks,
    project_context.tech_stack
  );
  
  // Update state with decisions
  const updatedSections = implementation_plan.sections.map(section => {
    if (pendingTasks.some(t => t.id === section.id)) {
      return {
        ...section,
        status: 'completed',
        assigned_agent: 'cto'
      };
    }
    return section;
  });
  
  return {
    implementation_plan: {
      ...state.implementation_plan,
      sections: updatedSections
    },
    messages: [
      ...state.messages,
      new AIMessage({
        content: `Architecture review completed for ${pendingTasks.length} tasks.`,
        additional_kwargs: { decisions: architectureDecisions }
      })
    ],
    current_step: 'architecture_reviewed'
  };
}

// Backend Node - Implements API endpoints
export async function backendNode(state: AgentState, config?: RunnableConfig) {
  const { implementation_plan, project_context } = state;
  
  // Get pending backend tasks
  const pendingBackendTasks = implementation_plan.sections.filter(
    section => section.status === 'pending' && 
              section.assigned_agent === 'backend'
  );
  
  if (pendingBackendTasks.length === 0) {
    return state; // No backend tasks
  }
  
  // Process each backend task
  const results = [];
  for (const task of pendingBackendTasks) {
    const result = await implementBackendTask(task, project_context);
    results.push(result);
    
    // Update task status
    const updatedSections = state.implementation_plan.sections.map(section => {
      if (section.id === task.id) {
        return { ...section, status: 'completed' };
      }
      return section;
    });
    
    return {
      implementation_plan: {
        ...state.implementation_plan,
        sections: updatedSections
      },
      messages: [
        ...state.messages,
        new AIMessage({
          content: `Backend implementation completed for ${task.title}.`,
          additional_kwargs: { result }
        })
      ],
      current_step: 'backend_implemented'
    };
  }
}

// Quality Review Node - Reviews implementation
export async function reviewNode(state: AgentState, config?: RunnableConfig) {
  const { implementation_plan, code_graph } = state;
  
  // Get completed tasks that need review
  const completedTasks = implementation_plan.sections.filter(
    section => section.status === 'completed' && 
              !section.reviewed
  );
  
  if (completedTasks.length === 0) {
    return state; // No tasks to review
  }
  
  // Perform quality review
  const reviewResults = await performQualityReview(completedTasks, code_graph);
  
  // Update quality metrics
  const qualityMetrics = calculateQualityMetrics(reviewResults);
  
  return {
    quality_metrics: {
      ...state.quality_metrics,
      ...qualityMetrics
    },
    messages: [
      ...state.messages,
      new AIMessage({
        content: `Quality review completed for ${completedTasks.length} tasks.`,
        additional_kwargs: { review: reviewResults }
      })
    ],
    current_step: 'quality_reviewed'
  };
}

// 3. LangGraph Workflow Definition
// lib/agents/workflow.ts
import { 
  StateGraph, 
  START, 
  END,
  Annotation
} from "@langchain/langgraph";

// Define the state annotation
const AgentStateAnnotation = Annotation.Root({
  messages: Annotation<BaseMessage[]>({
    reducer: (a, b) => [...a, ...b],
    default: () => []
  }),
  current_step: Annotation<string>,
  completed_steps: Annotation<string[]>({
    reducer: (a, b) => [...a, ...b],
    default: () => []
  }),
  pending_tasks: Annotation<string[]>({
    reducer: (a, b) => [...a, ...b],
    default: () => []
  }),
  project_context: Annotation<any>(),
  implementation_plan: Annotation<any>(),
  code_graph: Annotation<any>(),
  agent_assignments: Annotation<Record<string, string>>({
    reducer: (a, b) => ({ ...a, ...b }),
    default: () => ({})
  }),
  agent_results: Annotation<Record<string, any>>({
    reducer: (a, b) => ({ ...a, ...b }),
    default: () => ({})
  }),
  quality_metrics: Annotation<any>(),
  error_history: Annotation<any[]>({
    reducer: (a, b) => [...a, ...b],
    default: () => []
  }),
  created_at: Annotation<string>(),
  updated_at: Annotation<string>(),
  version: Annotation<string>()
});

// Create the workflow
export function createAgentWorkflow() {
  const workflow = new StateGraph(AgentStateAnnotation)
    .addNode("planner", plannerNode)
    .addNode("cto", ctoNode)
    .addNode("backend", backendNode)
    .addNode("frontend", frontendNode)
    .addNode("database", databaseNode)
    .addNode("auth", authNode)
    .addNode("review", reviewNode)
    .addNode("testing", testingNode)
    .addNode("security", securityNode)
    .addNode("deploy", deployNode);

  // Define the flow
  workflow.addEdge(START, "planner");
  workflow.addEdge("planner", "cto");
  workflow.addEdge("cto", "database");
  workflow.addEdge("database", "backend");
  workflow.addEdge("backend", "frontend");
  workflow.addEdge("frontend", "auth");
  workflow.addEdge("auth", "security");
  workflow.addEdge("security", "testing");
  workflow.addEdge("testing", "review");
  workflow.addEdge("review", "deploy");
  workflow.addEdge("deploy", END);

  // Conditional edges for error handling
  workflow.addConditionalEdges(
    "review",
    (state: AgentState) => {
      // If quality metrics are below threshold, go back to implementation
      if (state.quality_metrics.alignment_score < 70) {
        return "backend"; // Go back to fix issues
      }
      return "deploy"; // Otherwise proceed to deployment
    },
    ["backend", "deploy"]
  );

  return workflow.compile();
}

// 4. Graph Execution with Error Recovery
// lib/agents/executor.ts
import { createAgentWorkflow } from './workflow.js';
import { monitoring } from '../utils/monitoring.js';
import { errorRecovery } from '../utils/error-recovery.js';

export class AgentGraphExecutor {
  private workflow: any;
  private circuitBreaker: CircuitBreaker;

  constructor() {
    this.workflow = createAgentWorkflow();
    this.circuitBreaker = new CircuitBreaker({
      name: 'agent-workflow',
      failureThreshold: 3,
      timeout: 300000, // 5 minutes
      resetTimeout: 60000 // 1 minute
    });
  }

  async executeWorkflow(initialState: AgentState, options: {
    maxRetries?: number;
    timeout?: number;
    enableRecovery?: boolean;
  } = {}) {
    const { maxRetries = 3, timeout = 600000, enableRecovery = true } = options;

    // Wrap execution in circuit breaker
    return await this.circuitBreaker.call(async () => {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), timeout);

      try {
        // Execute workflow with monitoring
        monitoring.info('Starting agent workflow execution', {
          workflowId: crypto.randomUUID(),
          initialState: {
            project: initialState.project_context.name,
            tasks: initialState.pending_tasks.length
          }
        });

        const result = await this.workflow.invoke(initialState, {
          configurable: {
            thread_id: crypto.randomUUID(),
          },
          signal: controller.signal
        });

        clearTimeout(timeoutId);

        // Record successful execution
        monitoring.recordPerformance('agent_workflow_execution', {
          duration: Date.now() - Date.parse(initialState.created_at),
          success: true,
          tasksProcessed: result.completed_steps.length
        });

        return result;
      } catch (error) {
        clearTimeout(timeoutId);

        // Record error
        monitoring.error('Agent workflow execution failed', {
          error: error.message,
          stack: error.stack,
          workflowState: initialState.current_step
        });

        // Add to error history
        const errorEntry = {
          timestamp: new Date().toISOString(),
          error: error.message,
          context: initialState.current_step,
          recovery_attempted: false
        };

        if (enableRecovery) {
          // Attempt recovery
          const recoveryResult = await this.attemptRecovery(initialState, error, errorEntry);
          return recoveryResult;
        }

        throw error;
      }
    });
  }

  private async attemptRecovery(state: AgentState, error: Error, errorEntry: any) {
    // Add error to history
    const updatedState = {
      ...state,
      error_history: [...state.error_history, errorEntry]
    };

    // Try different recovery strategies
    const recoveryStrategies = [
      () => this.retryWithBackoff(updatedState),
      () => this.fallbackToSimplerAgent(updatedState),
      () => this.partialRecovery(updatedState)
    ];

    for (const strategy of recoveryStrategies) {
      try {
        const result = await strategy();
        if (result) {
          monitoring.info('Recovery successful', {
            strategy: strategy.name,
            error: error.message
          });
          return result;
        }
      } catch (recoveryError) {
        monitoring.warn('Recovery strategy failed', {
          strategy: strategy.name,
          error: recoveryError.message
        });
        continue;
      }
    }

    throw error; // All recovery strategies failed
  }

  private async retryWithBackoff(state: AgentState) {
    // Implement retry with exponential backoff
    const maxRetries = 3;
    for (let i = 0; i < maxRetries; i++) {
      try {
        const delay = Math.pow(2, i) * 1000; // 1s, 2s, 4s
        await new Promise(resolve => setTimeout(resolve, delay));
        
        return await this.workflow.invoke(state);
      } catch (error) {
        if (i === maxRetries - 1) throw error;
      }
    }
  }

  private async fallbackToSimplerAgent(state: AgentState) {
    // Fallback to simpler agent implementation
    // This would implement a simplified version of the failed task
    return state; // Simplified for example
  }

  private async partialRecovery(state: AgentState) {
    // Attempt to recover by skipping failed tasks
    // and continuing with remaining workflow
    return state; // Simplified for example
  }
}

// 5. State Persistence and Checkpointing
// lib/agents/checkpointer.ts
import { BaseStore } from "@langchain/core/stores";
import { createClient } from "redis";

export class RedisCheckpointer extends BaseStore {
  private client: any;

  constructor(redisUrl: string) {
    super();
    this.client = createClient({ url: redisUrl });
    this.client.connect();
  }

  async get(namespace: string[], key: string) {
    const fullKey = namespace.join(':') + ':' + key;
    const value = await this.client.get(fullKey);
    return value ? JSON.parse(value) : null;
  }

  async mget(keys: Array<[string[], string]>) {
    const fullKeys = keys.map(([namespace, key]) => namespace.join(':') + ':' + key);
    const values = await this.client.mGet(fullKeys);
    return values.map(value => value ? JSON.parse(value) : null);
  }

  async put(namespace: string[], key: string, value: any) {
    const fullKey = namespace.join(':') + ':' + key;
    await this.client.setEx(fullKey, 3600, JSON.stringify(value)); // 1 hour expiry
  }

  async putWrites(threadId: string, writes: Array<[string, any]>, step: number) {
    const key = `writes:${threadId}:${step}`;
    await this.put([], key, writes);
  }

  async list(config: any) {
    // Implementation for listing checkpoints
    const pattern = `checkpoint:${config.thread_id}:*`;
    const keys = await this.client.keys(pattern);
    return keys.map(key => {
      const parts = key.split(':');
      return {
        thread_id: parts[1],
        step: parseInt(parts[2])
      };
    });
  }
}

// 6. Agent Integration with Ultra-Dex CLI
// lib/commands/graph-agent.js
import { AgentGraphExecutor } from '../agents/executor.js';
import { AgentState } from '../agents/state.js';
import { monitoring } from '../utils/monitoring.js';
import { projectGraph } from '../mcp/graph.js';

export async function graphAgentCommand(task, options) {
  console.log('🤖 Starting Graph-Augmented Agent Swarm...\n');

  // Build initial state from project context
  const projectContext = await loadProjectContext();
  const graphSummary = await projectGraph.scan();

  const initialState: AgentState = {
    messages: [new HumanMessage({ content: task })],
    current_step: 'initial',
    completed_steps: [],
    pending_tasks: [task],
    project_context: {
      name: projectContext.name,
      description: projectContext.description,
      tech_stack: projectContext.tech_stack || [],
      current_phase: projectContext.current_phase || 'planning'
    },
    implementation_plan: projectContext.implementation_plan || {
      sections: []
    },
    code_graph: graphSummary,
    agent_assignments: {},
    agent_results: {},
    quality_metrics: {
      alignment_score: 0,
      code_quality: 0,
      security_score: 0,
      performance_score: 0
    },
    error_history: [],
    created_at: new Date().toISOString(),
    updated_at: new Date().toISOString(),
    version: '3.4.2'
  };

  const executor = new AgentGraphExecutor();

  try {
    const result = await executor.executeWorkflow(initialState, {
      maxRetries: options.maxRetries || 3,
      timeout: options.timeout || 600000, // 10 minutes default
      enableRecovery: options.recovery !== false
    });

    console.log('✅ Agent swarm completed successfully!');
    console.log(`📊 Results: ${result.completed_steps.length} steps completed`);
    
    if (options.export) {
      await exportAgentResults(result, options.export);
    }

    return result;
  } catch (error) {
    console.error('❌ Agent swarm failed:', error.message);
    throw error;
  }
}

export function registerGraphAgentCommand(program) {
  program
    .command('graph-agent <task>')
    .description('Run graph-augmented agent swarm with persistent state')
    .option('-r, --max-retries <n>', 'Maximum retry attempts', '3')
    .option('-t, --timeout <ms>', 'Operation timeout in milliseconds', '600000')
    .option('--no-recovery', 'Disable error recovery mechanisms')
    .option('-e, --export <path>', 'Export results to file')
    .action(graphAgentCommand);
}

// 7. Real-time Graph Updates During Execution
// lib/agents/graph-updater.ts
import { WebSocket } from 'ws';
import { projectGraph } from '../mcp/graph.js';
import { monitoring } from '../utils/monitoring.js';

export class GraphUpdater {
  private ws: WebSocket | null = null;
  private connected: boolean = false;

  constructor(private wsUrl: string) {}

  async connect() {
    this.ws = new WebSocket(this.wsUrl);
    
    this.ws.on('open', () => {
      this.connected = true;
      monitoring.info('Graph updater connected to WebSocket');
    });

    this.ws.on('error', (error) => {
      monitoring.error('Graph updater WebSocket error', { error: error.message });
    });

    this.ws.on('close', () => {
      this.connected = false;
      monitoring.warn('Graph updater WebSocket disconnected');
    });
  }

  async updateGraphDuringExecution(executionId: string, updates: any[]) {
    if (!this.connected || !this.ws) {
      return;
    }

    const graphUpdate = {
      type: 'graph_update',
      executionId,
      updates,
      timestamp: new Date().toISOString()
    };

    // Update local graph
    await projectGraph.update(updates);

    // Broadcast to WebSocket
    this.ws.send(JSON.stringify(graphUpdate));
  }

  async disconnect() {
    if (this.ws) {
      this.ws.close();
    }
  }
}

// 8. Performance Monitoring for Graph Operations
// lib/agents/performance.ts
export class GraphPerformanceMonitor {
  private metrics: Map<string, { start: number; end?: number; tags: any[] }> = new Map();

  startOperation(operationId: string, tags: any[] = []) {
    this.metrics.set(operationId, {
      start: performance.now(),
      tags
    });
  }

  endOperation(operationId: string) {
    const metric = this.metrics.get(operationId);
    if (metric) {
      const duration = performance.now() - metric.start;
      metric.end = performance.now();

      monitoring.recordPerformance(`graph_operation_${operationId}`, {
        duration,
        tags: metric.tags,
        success: true
      });

      this.metrics.delete(operationId);
      return duration;
    }
    return null;
  }

  getMetrics() {
    return Array.from(this.metrics.entries()).map(([id, metric]) => ({
      id,
      duration: metric.end ? metric.end - metric.start : performance.now() - metric.start,
      tags: metric.tags
    }));
  }
}

// 9. Error Recovery Integration
// lib/agents/recovery.ts
import { errorRecovery } from '../utils/error-recovery.js';

export class AgentRecoverySystem {
  constructor(private executor: AgentGraphExecutor) {}

  async handleAgentError(error: Error, currentState: AgentState, context: string) {
    // Log error with context
    monitoring.error('Agent error occurred', {
      error: error.message,
      context,
      step: currentState.current_step,
      tasks: currentState.pending_tasks
    });

    // Attempt recovery based on error type
    switch (this.classifyError(error)) {
      case 'transient':
        return await this.handleTransientError(error, currentState);
      case 'permanent':
        return await this.handlePermanentError(error, currentState);
      case 'configuration':
        return await this.handleConfigurationError(error, currentState);
      default:
        throw error; // Unable to recover
    }
  }

  private classifyError(error: Error): 'transient' | 'permanent' | 'configuration' {
    const message = error.message.toLowerCase();
    
    if (message.includes('timeout') || message.includes('network') || message.includes('connection')) {
      return 'transient';
    }
    
    if (message.includes('invalid') || message.includes('malformed') || message.includes('syntax')) {
      return 'configuration';
    }
    
    return 'permanent';
  }

  private async handleTransientError(error: Error, state: AgentState) {
    // Retry with exponential backoff
    return await errorRecovery.withRetry(
      () => this.executor.executeWorkflow(state),
      { maxRetries: 3, backoff: 'exponential' }
    );
  }

  private async handleConfigurationError(error: Error, state: AgentState) {
    // Return state to allow manual correction
    return {
      ...state,
      error_history: [
        ...state.error_history,
        {
          timestamp: new Date().toISOString(),
          error: error.message,
          context: 'configuration',
          recovery_attempted: true,
          recovery_strategy: 'manual_correction_needed'
        }
      ]
    };
  }

  private async handlePermanentError(error: Error, state: AgentState) {
    // Skip to next available step
    const nextStep = this.getNextAvailableStep(state);
    return {
      ...state,
      current_step: nextStep,
      error_history: [
        ...state.error_history,
        {
          timestamp: new Date().toISOString(),
          error: error.message,
          context: 'permanent',
          recovery_attempted: true,
          recovery_strategy: 'skip_to_next_step'
        }
      ]
    };
  }

  private getNextAvailableStep(state: AgentState): string {
    // Logic to determine next available step based on current state
    // This would implement the workflow graph traversal logic
    return state.current_step; // Simplified for example
  }
}
