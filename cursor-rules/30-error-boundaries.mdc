// hooks/use-async-error.ts
import { useCallback, useState } from 'react';

export function useAsyncError() {
  const [, setError] = useState();

  return useCallback(
    (error: Error) => {
      setError(() => {
        throw error;
      });
    },
    [setError]
  );
}

// 3. API Route Error Handler
// lib/api-error-handler.ts
import { NextResponse } from 'next/server';
import { captureException } from '@sentry/nextjs';

export class APIErrorHandler {
  static handle(error: any, context: string = 'API Route') {
    console.error(`${context} Error:`, error);
    
    // Capture in error monitoring
    captureException(error, {
      contexts: {
        api: { context }
      }
    });

    // Log for debugging
    const errorLog = {
      timestamp: new Date().toISOString(),
      context,
      error: {
        name: error.name,
        message: error.message,
        stack: process.env.NODE_ENV === 'development' ? error.stack : undefined,
        code: error.code,
        status: error.status
      },
      url: typeof window !== 'undefined' ? window.location.href : undefined
    };

    console.error('API Error Log:', JSON.stringify(errorLog, null, 2));

    // Return appropriate response
    if (error.status && error.status >= 400 && error.status < 500) {
      return NextResponse.json(
        { 
          error: 'Client Error',
          message: error.message || 'Invalid request',
          code: error.code || 'CLIENT_ERROR'
        },
        { status: error.status || 400 }
      );
    }

    return NextResponse.json(
      { 
        error: 'Server Error',
        message: 'An unexpected error occurred',
        code: 'SERVER_ERROR'
      },
      { status: 500 }
    );
  }

  static async safeExecute<T>(
    operation: () => Promise<T>,
    context: string = 'Operation'
  ): Promise<{ success: boolean; data?: T; error?: any }> {
    try {
      const data = await operation();
      return { success: true, data };
    } catch (error) {
      this.handle(error, context);
      return { success: false, error };
    }
  }
}

// 4. Server Action Error Handler
// lib/server-action-error-handler.ts
'use server';

import { captureException } from '@sentry/nextjs';

export class ServerActionErrorHandler {
  static async handleSafe<T>(
    operation: () => Promise<T>,
    context: string = 'Server Action'
  ): Promise<{ success: boolean; data?: T; error?: string }> {
    try {
      const data = await operation();
      return { success: true, data };
    } catch (error) {
      console.error(`${context} Error:`, error);
      
      // Capture in error monitoring
      captureException(error, {
        contexts: {
          serverAction: { context }
        }
      });

      // Log for debugging
      const errorLog = {
        timestamp: new Date().toISOString(),
        context,
        error: {
          name: error.name,
          message: error.message,
          stack: process.env.NODE_ENV === 'development' ? error.stack : undefined,
          code: error.code
        }
      };

      console.error('Server Action Error Log:', JSON.stringify(errorLog, null, 2));

      return {
        success: false,
        error: process.env.NODE_ENV === 'development' 
          ? error.message 
          : 'An unexpected error occurred'
      };
    }
  }

  static validateInput<T>(
    schema: any,
    data: any,
    context: string = 'Input Validation'
  ): { success: boolean; data?: T; error?: string } {
    try {
      const validated = schema.parse(data);
      return { success: true, data: validated };
    } catch (error) {
      console.error(`${context} Validation Error:`, error);
      
      return {
        success: false,
        error: error.message || 'Invalid input data'
      };
    }
  }
}

// 5. Database Error Handler with Retry Logic
// lib/db-error-handler.ts
import { PrismaClientKnownRequestError } from '@prisma/client/runtime/library';
import { captureException } from '@sentry/nextjs';

export class DatabaseErrorHandler {
  static async handleDatabaseError<T>(
    operation: () => Promise<T>,
    options: {
      maxRetries?: number;
      retryDelay?: number;
      context?: string;
    } = {}
  ): Promise<{ success: boolean; data?: T; error?: string }> {
    const { maxRetries = 3, retryDelay = 1000, context = 'Database Operation' } = options;
    let attempts = 0;

    while (attempts <= maxRetries) {
      try {
        const data = await operation();
        return { success: true, data };
      } catch (error) {
        attempts++;
        
        // Log the attempt
        console.error(`${context} Attempt ${attempts}/${maxRetries + 1} failed:`, error.message);
        
        // Check if it's a retryable error
        if (this.isRetryableError(error) && attempts <= maxRetries) {
          // Wait before retrying
          await new Promise(resolve => setTimeout(resolve, retryDelay * Math.pow(2, attempts - 1))); // Exponential backoff
          continue;
        }
        
        // Not retryable or max attempts reached
        console.error(`${context} Failed after ${attempts} attempts:`, error);
        
        // Capture in error monitoring
        captureException(error, {
          contexts: {
            database: { 
              context,
              attempts,
              maxRetries
            }
          }
        });

        return {
          success: false,
          error: this.getErrorMessage(error)
        };
      }
    }

    return {
      success: false,
      error: 'Operation failed after maximum retries'
    };
  }

  private static isRetryableError(error: any): boolean {
    // Check for common retryable database errors
    if (error instanceof PrismaClientKnownRequestError) {
      // Retry on connection issues, timeouts, etc.
      return ['P1001', 'P1002', 'P1008', 'P2002', 'P2034'].includes(error.code);
    }
    
    // Check for network errors
    if (error.code && ['ECONNRESET', 'ETIMEDOUT', 'ECONNREFUSED'].includes(error.code)) {
      return true;
    }
    
    // Check for generic network errors
    if (error.message && (
      error.message.includes('connection') || 
      error.message.includes('timeout') ||
      error.message.includes('network')
    )) {
      return true;
    }
    
    return false;
  }

  private static getErrorMessage(error: any): string {
    if (error instanceof PrismaClientKnownRequestError) {
      switch (error.code) {
        case 'P2002': // Unique constraint violation
          return 'A record with this value already exists';
        case 'P2025': // Record not found
          return 'The requested record was not found';
        default:
          return `Database error: ${error.message}`;
      }
    }
    
    return process.env.NODE_ENV === 'development' 
      ? error.message 
      : 'A database error occurred';
  }
}

// 6. Network Error Handler with Circuit Breaker
// lib/network-error-handler.ts
import { CircuitBreaker } from './circuit-breaker';

export class NetworkErrorHandler {
  private static circuitBreakers = new Map<string, CircuitBreaker>();

  static async handleNetworkRequest<T>(
    url: string,
    options: RequestInit = {},
    context: string = 'Network Request'
  ): Promise<{ success: boolean; data?: T; error?: string }> {
    // Get or create circuit breaker for this URL
    const circuitKey = `${context}:${url}`;
    if (!this.circuitBreakers.has(circuitKey)) {
      this.circuitBreakers.set(circuitKey, new CircuitBreaker({
        name: circuitKey,
        failureThreshold: 5,
        timeout: 60000,
        resetTimeout: 30000
      }));
    }

    const circuitBreaker = this.circuitBreakers.get(circuitKey)!;

    try {
      const result = await circuitBreaker.call(async () => {
        const response = await fetch(url, {
          ...options,
          timeout: 30000 // 30 second timeout
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        return await response.json();
      });

      return { success: true, data: result as T };
    } catch (error) {
      console.error(`${context} Network Error:`, error);
      
      return {
        success: false,
        error: process.env.NODE_ENV === 'development' 
          ? error.message 
          : 'A network error occurred'
      };
    }
  }
}

// 7. Circuit Breaker Implementation
// lib/circuit-breaker.ts
export class CircuitBreaker {
  private state: 'CLOSED' | 'OPEN' | 'HALF_OPEN' = 'CLOSED';
  private failureCount: number = 0;
  private lastFailureTime: number | null = null;
  private nextAttemptTime: number | null = null;
  
  constructor(
    private options: {
      name: string;
      failureThreshold: number;
      timeout: number;
      resetTimeout: number;
    }
  ) {}

  async call<T>(fn: () => Promise<T>): Promise<T> {
    if (this.state === 'OPEN') {
      if (Date.now() >= (this.nextAttemptTime || 0)) {
        this.state = 'HALF_OPEN';
      } else {
        throw new Error(`Circuit breaker ${this.options.name} is OPEN`);
      }
    }

    try {
      const result = await fn();
      
      if (this.state === 'HALF_OPEN') {
        this.reset();
      }
      
      return result;
    } catch (error) {
      this.onFailure();
      throw error;
    }
  }

  private onFailure() {
    this.failureCount++;
    this.lastFailureTime = Date.now();

    if (this.failureCount >= this.options.failureThreshold) {
      this.state = 'OPEN';
      this.nextAttemptTime = Date.now() + this.options.resetTimeout;
    }
  }

  private reset() {
    this.state = 'CLOSED';
    this.failureCount = 0;
    this.lastFailureTime = null;
    this.nextAttemptTime = null;
  }

  getStatus() {
    return {
      state: this.state,
      failureCount: this.failureCount,
      threshold: this.options.failureThreshold,
      lastFailureTime: this.lastFailureTime,
      nextAttemptTime: this.nextAttemptTime
    };
  }
}

// 8. Global Error Handler for Next.js App
// app/error.tsx
'use client';

import { useEffect } from 'react';
import { captureException } from '@sentry/nextjs';

export default function GlobalError({
  error,
  reset,
}: {
  error: Error & { digest?: string };
  reset: () => void;
}) {
  useEffect(() => {
    // Log error to error monitoring
    captureException(error, {
      contexts: {
        global: {
          digest: error.digest
        }
      }
    });
  }, [error]);

  return (
    <html>
      <body className="min-h-screen flex items-center justify-center bg-gray-50">
        <div className="max-w-md mx-auto p-8 bg-white rounded-lg shadow-lg text-center">
          <div className="w-16 h-16 mx-auto bg-red-100 rounded-full flex items-center justify-center mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" className="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          
          <h2 className="text-xl font-bold text-gray-900 mb-2">Application Error</h2>
          <p className="text-gray-600 mb-6">
            Something went wrong in the application. Our team has been notified.
          </p>
          
          <button
            onClick={
              // Attempt to recover by trying to re-render the segment
              () => reset()
            }
            className="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition-colors"
          >
            Try Again
          </button>
        </div>
      </body>
    </html>
  );
}

// 9. Loading Error Boundary for Dynamic Imports
// components/loading-boundary.tsx
'use client';

import { Suspense } from 'react';
import { ErrorBoundary } from './error-boundary';

interface LoadingBoundaryProps {
  children: React.ReactNode;
  fallback?: React.ReactNode;
  errorFallback?: React.ReactNode;
}

export function LoadingBoundary({ 
  children, 
  fallback = <div className="p-8 text-center">Loading...</div>,
  errorFallback 
}: LoadingBoundaryProps) {
  return (
    <ErrorBoundary fallback={errorFallback}>
      <Suspense fallback={fallback}>
        {children}
      </Suspense>
    </ErrorBoundary>
  );
}

// 10. Custom Hook for Error Handling in Components
// hooks/use-error-handler.ts
import { useState, useCallback } from 'react';

export interface ErrorHandler {
  error: string | null;
  setError: (error: string | null) => void;
  clearError: () => void;
  handleError: (error: any) => void;
  isLoading: boolean;
  setIsLoading: (loading: boolean) => void;
}

export function useErrorHandler(initialError: string | null = null): [ErrorHandler, JSX.Element | null] {
  const [error, setErrorState] = useState<string | null>(initialError);
  const [isLoading, setIsLoadingState] = useState<boolean>(false);

  const setError = useCallback((error: string | null) => {
    setErrorState(error);
  }, []);

  const clearError = useCallback(() => {
    setErrorState(null);
  }, []);

  const handleError = useCallback((error: any) => {
    const message = error.message || 'An unexpected error occurred';
    setErrorState(message);
    console.error('Handled error:', error);
  }, []);

  const setIsLoading = useCallback((loading: boolean) => {
    setIsLoadingState(loading);
  }, []);

  const errorHandler: ErrorHandler = {
    error,
    setError,
    clearError,
    handleError,
    isLoading,
    setIsLoading
  };

  const errorElement = error ? (
    <div className="mb-4 p-4 bg-red-50 border border-red-200 rounded text-red-700">
      <div className="font-medium">Error:</div>
      <div className="text-sm mt-1">{error}</div>
      <button 
        onClick={clearError}
        className="mt-2 text-sm text-red-600 hover:text-red-800 underline"
      >
        Dismiss
      </button>
    </div>
  ) : null;

  return [errorHandler, errorElement];
}
