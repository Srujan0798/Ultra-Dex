## URL Structure Best Practices

1. **Use lowercase**: `/blog/post-name` not `/Blog/Post-Name`
2. **Hyphens, not underscores**: `/my-post` not `/my_post`
3. **No special characters**: Avoid `&`, `?`, `%` in URLs
4. **Keep it short**: Max 60 characters
5. **Keywords first**: `/ai-development-tools` not `/tools/ai-development`

## Internal Linking Strategy

```typescript
// components/InternalLink.tsx
import Link from 'next/link';

interface InternalLinkProps {
  href: string;
  children: React.ReactNode;
  anchorText?: string; // Override text for SEO
}

export function InternalLink({ href, children, anchorText }: InternalLinkProps) {
  return (
    <Link 
      href={href}
      className="text-blue-600 hover:underline"
      // Anchor text should be descriptive
      title={anchorText}
    >
      {children}
    </Link>
  );
}

// Usage: Descriptive anchor text
<InternalLink href="/features/cli-commands" anchorText="Explore all 46 CLI commands">
  Full CLI Documentation
</InternalLink>
