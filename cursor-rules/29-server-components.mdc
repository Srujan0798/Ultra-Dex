// 6. Server Component with Database Relations
// components/project-details.tsx
import { db } from '@/lib/db';

export async function ProjectDetails({ projectId }: { projectId: string }) {
  const project = await db.project.findUnique({
    where: { id: projectId },
    include: {
      owner: {
        select: { name: true, email: true }
      },
      collaborators: {
        select: { name: true, email: true, role: true }
      },
      tasks: {
        where: { status: { not: 'completed' } },
        orderBy: { createdAt: 'desc' },
        take: 5
      }
    }
  });

  if (!project) {
    return <div>Project not found</div>;
  }

  return (
    <div className="space-y-4">
      <h2 className="text-xl font-bold">{project.name}</h2>
      <p className="text-gray-600">{project.description}</p>
      
      <div className="text-sm text-gray-500">
        Owned by: {project.owner.name} ({project.owner.email})
      </div>

      <div className="mt-4">
        <h3 className="font-semibold mb-2">Recent Tasks</h3>
        <ul className="space-y-1">
          {project.tasks.map(task => (
            <li key={task.id} className="text-sm">
              {task.title} - {task.status}
            </li>
          ))}
        </ul>
      </div>
    </div>
  );
}

// 7. Server Action with Transaction
// actions/bulk-actions.ts
'use server';

import { z } from 'zod';
import { db } from '@/lib/db';
import { currentUser } from '@clerk/nextjs';

const bulkDeleteSchema = z.object({
  projectIds: z.array(z.string())
});

export async function bulkDeleteProjects(formData: FormData) {
  try {
    const user = await currentUser();
    if (!user) {
      return { error: 'Authentication required' };
    }

    const projectIds = JSON.parse(formData.get('projectIds') as string);
    const validatedFields = bulkDeleteSchema.safeParse({ projectIds });

    if (!validatedFields.success) {
      return { error: 'Invalid project IDs' };
    }

    // Use transaction to ensure atomicity
    const deletedProjects = await db.$transaction(async (tx) => {
      // Verify user owns all projects
      const projects = await tx.project.findMany({
        where: {
          id: { in: validatedFields.data.projectIds },
          userId: user.id
        }
      });

      if (projects.length !== validatedFields.data.projectIds.length) {
        throw new Error('Some projects do not belong to user');
      }

      // Delete projects
      return await tx.project.deleteMany({
        where: {
          id: { in: validatedFields.data.projectIds },
          userId: user.id
        }
      });
    });

    revalidatePath('/dashboard');
    
    return {
      success: true,
      deletedCount: deletedProjects.count
    };
  } catch (error) {
    console.error('Bulk delete error:', error);
    return { error: 'Failed to delete projects' };
  }
}

// 8. Server Component with Caching
// components/popular-projects.tsx
import 'server-only'; // Ensures this only runs on server
import { db } from '@/lib/db';

// This component will be cached by Next.js
export async function PopularProjects({ limit = 5 }: { limit?: number }) {
  const projects = await db.project.findMany({
    where: { visibility: 'public' },
    orderBy: { views: 'desc' },
    take: limit,
    select: {
      id: true,
      name: true,
      description: true,
      views: true,
      createdAt: true
    }
  });

  return (
    <div className="bg-white rounded-lg shadow p-6">
      <h3 className="text-lg font-semibold mb-4">Popular Projects</h3>
      <ul className="space-y-3">
        {projects.map(project => (
          <li key={project.id} className="border-b pb-3 last:border-0 last:pb-0">
            <a href={`/projects/${project.id}`} className="hover:underline">
              <div className="font-medium">{project.name}</div>
              <div className="text-sm text-gray-600 truncate">{project.description}</div>
              <div className="text-xs text-gray-500 mt-1">
                {project.views} views • {project.createdAt.toLocaleDateString()}
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  );
}

// 9. Error Boundaries for Server Components
// components/error-boundary.tsx
'use client';

import { Component, ReactNode } from 'react';

interface Props {
  children: ReactNode;
  fallback?: ReactNode;
}

interface State {
  hasError: boolean;
  error?: Error;
}

export class ServerComponentErrorBoundary extends Component<Props, State> {
  constructor(props: Props) {
    super(props);
    this.state = { hasError: false };
  }

  static getDerivedStateFromError(error: Error): State {
    return { hasError: true, error };
  }

  componentDidCatch(error: Error, errorInfo: any) {
    console.error('Server component error:', error, errorInfo);
  }

  render() {
    if (this.state.hasError) {
      return this.props.fallback || (
        <div className="p-4 bg-red-50 border border-red-200 rounded">
          <h3 className="text-red-800 font-medium">Something went wrong</h3>
          <p className="text-red-600 text-sm mt-1">{this.state.error?.message}</p>
        </div>
      );
    }

    return this.props.children;
  }
}

