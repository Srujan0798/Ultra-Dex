{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "downlevelIteration": true,
    "ignoreDeprecations": "6.0",
    "experimentalDecorators": true
  },
  "include": [
    "apps/dashboard/app/**/*.ts",
    "apps/dashboard/app/**/*.tsx",
    "apps/dashboard/components/**/*.ts",
    "apps/dashboard/components/**/*.tsx",
    "apps/dashboard/lib/**/*.ts",
    "apps/dashboard/lib/**/*.tsx",
    "apps/cloud/ide/src/**/*.ts",
    "apps/cloud/ide/src/**/*.tsx",
    "src/core/interfaces/**/*.ts",
    "src/types/**/*.ts"
  ],
  "exclude": [
    "apps/cli/assets/**",
    "apps/cli/lib/templates/**",
    "apps/cli/lib/utils/error-handler.ts",
    "apps/cli/lib/utils/performance-optimizer.ts",
    "apps/cli/lib/spinner.ts",
    "src/core/utils/token-forecast.ts",
    "src/core/utils/validation.ts",
    "src/core/utils/version-display.ts",
    "src/core/utils/version.ts",
    "apps/mobile/**",
    "examples/**",
    "src/types/enterprise.ts",
    "apps/dashboard/src/**",
    "node_modules",
    "dist",
    "build",
    "**/*.test.ts"
  ]
}
