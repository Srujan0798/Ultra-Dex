{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": [
    "core/**/*.ts",
    "runtime/**/*.ts",
    "memory/**/*.ts",
    "dexgraph/**/*.ts",
    "adapters/**/*.ts",
    "governance/**/*.ts",
    "tools/**/*.ts",
    "observability/**/*.ts",
    "cli/**/*.ts",
    "sdk/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
