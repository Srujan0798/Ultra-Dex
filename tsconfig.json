{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "downlevelIteration": true,
    "ignoreDeprecations": "6.0",
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["apps/dashboard/*"]
    }
  },
  "include": [
    "apps/dashboard/app/layout.tsx",
    "apps/dashboard/app/page.tsx",
    "apps/dashboard/app/tasks/page.tsx",
    "apps/dashboard/app/agents/page.tsx",
    "apps/dashboard/app/memory/page.tsx",
    "apps/dashboard/app/analytics/page.tsx",
    "apps/cloud/ide/src/**/*.ts",
    "apps/cloud/ide/src/**/*.tsx"
  ],
  "exclude": [
    "apps/cli/assets/**",
    "apps/cli/lib/templates/**",
    "apps/cli/lib/utils/error-handler.ts",
    "apps/cli/lib/utils/performance-optimizer.ts",
    "apps/cli/lib/spinner.ts",
    "src/core/utils/token-forecast.ts",
    "src/core/utils/validation.ts",
    "src/core/utils/version-display.ts",
    "src/core/utils/version.ts",
    "src/core/agents/ralph-loop.ts",
    "apps/mobile/**",
    "examples/**",
    "src/types/enterprise.ts",
    "apps/dashboard/src/**",
    "apps/dashboard/components/AgentStatus.tsx",
    "apps/dashboard/components/ConfigEditor.tsx",
    "node_modules",
    "dist",
    "build",
    "**/*.test.ts"
  ]
}
