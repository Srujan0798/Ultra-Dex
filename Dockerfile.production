# Ultra-Dex Production Dockerfile
# Multi-stage build for production deployment

# Stage 1: Builder
FROM node:22-alpine AS builder

WORKDIR /app

# Install dependencies first for better caching
COPY package*.json ./
COPY apps/cli/package*.json ./apps/cli/
COPY apps/core-api/package*.json ./apps/core-api/
COPY apps/dashboard/package*.json ./apps/dashboard/

RUN npm ci --only=production --legacy-peer-deps

# Copy source code
COPY . .

# Build core modules
RUN npm run build:core

# Build dashboard
RUN npm run build:dashboard

# Stage 2: Production runtime
FROM node:22-alpine AS production

# Create non-root user for security
RUN addgroup -g 1001 -S ultra && \
    adduser -u 1001 -S ultra -G ultra

WORKDIR /app

# Copy package files
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/apps/cli/package*.json ./apps/cli/

# Copy built artifacts
COPY --from=builder --chown=ultra:ultra /app/node_modules ./node_modules
COPY --from=builder --chown=ultra:ultra /app/apps ./apps
COPY --from=builder --chown=ultra:ultra /app/src ./src
COPY --from=builder --chown=ultra:ultra /app/packages ./packages
COPY --from=builder --chown=ultra:ultra /app/bin ./bin
COPY --from=builder --chown=ultra:ultra /app/config ./config
COPY --from=builder --chown=ultra:ultra /app/templates ./templates
COPY --from=builder --chown=ultra:ultra /app/docs ./docs

# Create data directory with proper permissions
RUN mkdir -p /data && chown ultra:ultra /data

# Switch to non-root user
USER ultra

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:4000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)}).on('error', () => process.exit(1))"

# Environment variables
ENV NODE_ENV=production
ENV ULTRA_DEX_DATA_DIR=/data
ENV PORT=4000
ENV LOG_LEVEL=info
ENV CI=true

# Expose ports
EXPOSE 4000  # Main API
EXPOSE 4001  # Dashboard
EXPOSE 4002  # MCP Server

# Default command
CMD ["node", "apps/cli/bin/ultra-dex.js", "serve", "--port", "4000"]