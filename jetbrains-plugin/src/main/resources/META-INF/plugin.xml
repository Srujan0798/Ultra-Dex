<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
  <id>com.ultra.dex.plugin</id>
  <name>Ultra-Dex AI Development</name>
  <version>1.0.0</version>
  <vendor email="support@ultra-dex.ai" url="https://ultra-dex.ai">Ultra-Dex</vendor>

  <description><![CDATA[
  AI-powered development tools with persistent memory and governance.
  <br/>
  Features:
  <ul>
    <li>AI agent integration</li>
    <li>Persistent context management</li>
    <li>Code analysis and suggestions</li>
    <li>MCP protocol support</li>
    <li>Voice-to-code functionality</li>
  </ul>
  ]]></description>

  <change-notes><![CDATA[
  Initial release with core AI development features.
  ]]></change-notes>

  <!-- please see https://www.jetbrains.org/intellij/sdk/docs/basics/getting_started/plugin_compatibility.html
       on how to target different products -->
  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <!-- Add your extensions here -->
  </extensions>

  <actions>
    <!-- Add your actions here -->
    <action id="UltraDex.OpenDashboard" class="com.ultra.dex.actions.OpenDashboardAction" text="Open Ultra-Dex Dashboard" description="Open the Ultra-Dex dashboard">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="UltraDex.RunAgent" class="com.ultra.dex.actions.RunAgentAction" text="Run Ultra-Dex Agent" description="Run an AI agent">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <action id="UltraDex.SyncContext" class="com.ultra.dex.actions.SyncContextAction" text="Sync Context" description="Sync project context with Ultra-Dex">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>

</idea-plugin>