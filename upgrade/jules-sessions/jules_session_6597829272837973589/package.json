{
  "name": "ultra-dex-monorepo",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky install",
    "preinstall": "npx only-allow npm",
    "postinstall": "npm rebuild",
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:push": "turbo run test --filter=...[origin/main] --ignore=apps/cli",
    "test:push:smoke": "turbo run test --filter=...[origin/main] --ignore=apps/cli --ignore=src/core/integrations/git.test.js --ignore=apps/cli/test/git-workflow.test.js --ignore=tests/cli",
    "test:ci": "turbo run test:ci",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "start": "turbo run start",
    "verify": "turbo run verify",
    "db:push": "turbo run db:push",
    "db:studio": "turbo run db:studio",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "husky": "^9.0.11",
    "prettier": "^3.2.5",
    "turbo": "^1.12.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@10.2.4",
  "overrides": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  }
}
