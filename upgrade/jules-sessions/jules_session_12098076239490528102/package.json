  "lint-staged": {
    "*.{js,ts,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*.js": [
      "eslint --fix"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "npm run gate:push"
    }
  },
  "overrides": {
    "tar": "7.5.7",
    "@mapbox/node-pre-gyp": "2.0.3",
    "react": "18.2.0",
    "@types/react": "18.2.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "volta": {
    "node": "20.18.0",
    "npm": "10.8.2"
  }
