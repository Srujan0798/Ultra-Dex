    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.10.10",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
