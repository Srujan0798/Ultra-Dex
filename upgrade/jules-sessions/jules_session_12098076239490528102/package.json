    "@langchain/langgraph": "^0.2.30",
    "@langchain/openai": "^0.3.15",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "@notionhq/client": "^2.3.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
