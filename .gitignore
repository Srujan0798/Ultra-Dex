# ============================================================================
# Ultra-Dex .gitignore
# ============================================================================

# OS files
.DS_Store
**/.DS_Store
Thumbs.db

# Dependencies
node_modules/
**/node_modules/

# Build artifacts
*.vsix
**/out/
**/*.tsbuildinfo
**/dist/
**/.next/
**/.docusaurus/

# Environment
.env
.env.local
.env.source
.env.*.local
.env.*
!.env.example

# Runtime data (regenerated automatically)
.ultra/
.ultra-dex/
**/.ultra/
**/.ultra-dex/
.state/
**/.state/
data/memory.db
data/autopsy/
data/observability/
data/agent-registry.json

# Logs
*.log
**/*.log
.aider*
logs/
**/logs/

# Test Coverage
coverage/
.nyc_output/

# Reports
*-report.json

# Large assets (use Git LFS)
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.svg
*.webp

# IDE
.idea/
.vscode/settings.json
*.swp
*.swo

# Temp and cache
tmp/
.cache/
**/.cache/

# Backup files (auto-generated by agents)
*-bak/
**/*-bak/
*.bak
**/*.bak

# Duplicate directories (agent artifacts)
* 2/
**/* 2/
* 2.*
**/* 2.*

# Local suspension recovery bundles
gitFail/backups/*.bundle

# Upgrade archives
upgrade/

# Archive (historical WIP, session dumps, old reports)
archive/

# Kilo worktrees
.kilo/

# Cursor rules (local overrides)
.cursor/

# Qwen Code settings
.qwen/

# Jupyter sessions
jules-sessions-*/

# Package lock variants
package-lock*.json
!package-lock.json

# Docker
docker-compose.override.yml
