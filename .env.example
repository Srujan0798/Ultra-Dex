# Environment Variables
# Copy this file to .env.local and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Authentication
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# API Keys
# Add your API keys here

# NVIDIA Nemotron AI Provider (Free tier available)
# Get your API key at: https://build.nvidia.com/
# You can add multiple keys for load balancing and rate limit avoidance
NVIDIA_API_KEY=your-primary-api-key-here
NVIDIA_API_KEY_1=your-secondary-api-key-here
NVIDIA_API_KEY_2=your-tertiary-api-key-here
NVIDIA_API_KEY_3=your-fourth-api-key-here
