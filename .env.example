# Environment Variables
# Copy this file to .env.local and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Authentication
NEXTAUTH_SECRET=<generate with: openssl rand -base64 32>
NEXTAUTH_URL=http://localhost:3000

# API Keys
# Add your API keys here

# NVIDIA Nemotron AI Provider (Free tier available)
# Get your API key at: https://build.nvidia.com/
# You can add multiple keys for load balancing and rate limit avoidance
NVIDIA_API_KEY=your-primary-api-key-here
NVIDIA_API_KEY_1=your-secondary-api-key-here
NVIDIA_API_KEY_2=your-tertiary-api-key-here
NVIDIA_API_KEY_3=your-fourth-api-key-here

# Optional default provider override
ULTRA_DEX_DEFAULT_PROVIDER=nvidia

# Optional alternate providers (set any one you use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_KEY=

# Optional local provider (no API key)
OLLAMA_HOST=http://localhost:11434

# Better Stack logging
BETTER_STACK_SOURCE_TOKEN=

# Clerk auth
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Error tracking (secondary to Better Stack log alerts)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=sagavoyager-aeternis
SENTRY_PROJECT=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
